// expect: error[motion] door_l.panel hits door_r.panel when door_l is opened past 0.1deg
// fix: patch "Use right: 8mm" { set door_l.mount = overlay(left: 16mm, right: 8mm, top: -2mm, bottom: 16mm) }
stave 1

// A pair of doors hinged on the same middle divider, their hinge edges
// meeting with no gap between them. A cup hinge pushes its door out and
// swings the hinge edge sideways by about a millimetre as it opens: into
// the other door. Doors that share a divider need a small gap.

project "Double doors with no gap" {
  units: mm
}

stock ply_18 { species: birch, form: plywood, thickness: 18mm, max_length: 2440mm }

part base : ply_18 {
  length: 800mm
  width:  400mm
  place {
    ground
  }
}

part side_l : ply_18 {
  length: 700mm
  width:  400mm
  place {
    orient(length: up, width: back)
    against(base.top)
    flush(base.left)
    flush(base.front)
  }
}

part side_r = mirror(side_l, about: mid(base, across))

/// The top overhangs the front by 30mm.
part top : ply_18 {
  length: 800mm
  width:  430mm
  place {
    against(side_l.top)
    flush(base.left)
    flush(base.back)
  }
}

part divider : ply_18 {
  length: 700mm
  width:  400mm
  place {
    orient(length: up, width: back)
    against(base.top)
    center(base, across)
    flush(base.front)
  }
}

region bay_l = opening(
  left:   side_l.right,
  right:  divider.left,
  bottom: base.top,
  top:    side_l.top,
  front:  base.front,
  back:   base.back,
)

// Each door covers half the divider: 9mm, on hinges with 9mm plates.
assembly door_l : Door {
  opening:    bay_l
  hinge_side: divider
  mount:      overlay(left: 16mm, right: 9mm, top: -2mm, bottom: 16mm)
}

assembly door_r = mirror(door_l, about: mid(base, across))
