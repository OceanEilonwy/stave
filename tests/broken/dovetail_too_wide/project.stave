// expect: error[overlap] beam_b and beam_a overlap
stave 1

// The tail is cut at a steeper angle than its socket, so at its end it is
// wider than the socket's bottom: its sloped faces go into beam_a.

project "Dovetail too wide" {
  units: mm
}

stock pine_90 { species: pine, form: solid, thickness: 90mm, width: 90mm }

part beam_a : pine_90 {
  length: 500mm
  place {
    ground
  }
}

part beam_b : pine_90 {
  length: 500mm
  place {
    against(beam_a.right)
    flush(beam_a.bottom)
    flush(beam_a.front)
  }
}

/// A dovetailed end joint, with the tail marked at the wrong angle.
kind end_dovetail : joint {
  param neck  = piece.width / 3
  param depth = piece.width / 2
  param angle = 10deg

  insert:    [push(piece, along: thickness)]
  cut_first: piece
  adds:      extend(piece, by: depth)

  cut end(into, facing: piece) {
    dovetail_socket(neck: neck, depth: depth, angle: angle)
  }
  cut end(piece, facing: into) {
    dovetail_tail(neck: neck, depth: depth, angle: angle + 2deg)
  }
}

joint splice : end_dovetail(beam_b, into: beam_a)
