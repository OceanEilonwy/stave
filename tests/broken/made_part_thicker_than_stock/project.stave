// expect: error[type-mismatch] top.spline[1]: its thickness works out as about 6.333333mm, but ply_6 is only 6mm thick
stave 1

// The top is glued up from two boards with a spline in the seam. The
// spline is a third of the board's thickness, 6.33mm, but it is cut from
// 6mm plywood: a part a joint makes is held to its stock like any other.

project "A spline thicker than its plywood" {
  units: mm
}

stock oak   { species: white_oak, form: solid, thickness: 19mm, max_width: 200mm, max_length: 2400mm }
stock ply_6 { species: birch, form: plywood, thickness: 6mm, max_width: 1220mm, max_length: 2440mm }

part top : oak {
  length: 800mm
  width:  380mm
  boards: joined(by: splined_edge(spline_stock: ply_6))
  place { ground }
}
