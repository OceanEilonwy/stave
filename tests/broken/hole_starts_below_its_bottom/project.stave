// expect: error[cut-size] corner: its pilot hole in stile starts 12mm below the face but stops 12mm below it
stave 1

// A stepped hole whose wide part is written to start where the hole ends.

project "Hole starts below its bottom" {
  units: mm
}

kind slanted : joint {
  member screw : wood_screw(diameter: 4mm, length: 32mm) {
    on:    contact(piece, into)
    count: 2
    shape: cylinder(diameter: 3mm, depth: -20mm..12mm, tilt: 15deg, toward: across)
  }
  cut pocket: crossing(piece, screw) { drill(diameter: 9.5mm, depth: through, from_depth: 20mm) }
  cut shank_hole: crossing(piece, screw) { drill(diameter: 4.5mm, depth: 20mm) }
  cut pilot_hole: crossing(into, screw) { drill(diameter: 3mm, depth: 12mm, from_depth: 12mm) }
}

stock pine_strip { species: pine, form: solid, thickness: 19mm, width: 50mm, max_length: 2400mm }

part stile : pine_strip {
  length: 600mm
  place {
    ground
    orient(length: back, width: right)
  }
}

part rail : pine_strip {
  length: 300mm
  place {
    orient(length: right, width: back)
    against(stile.right)
    flush(stile.bottom)
    flush(stile.back)
  }
}

joint corner : slanted(rail, into: stile)
