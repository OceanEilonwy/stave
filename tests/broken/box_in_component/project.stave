// expect: error[ground] 'space' is made with 'box' inside a component
stave 1

project "A box in a component" {
  units: mm
}

param overall_width  = 600mm
param overall_height = 400mm
param overall_depth  = 300mm

region envelope = box(across: overall_width, up: overall_height, deep: overall_depth)

stock pine_19 { species: pine, form: solid, thickness: 19mm, max_length: 2400mm }

part base : pine_19 {
  length: overall_width
  width:  overall_depth
  place {
    flush(envelope.bottom)
    flush(envelope.left)
    flush(envelope.front)
  }
}

component Tray {
  // A component is handed its space as a Region param; it can't be the root.
  region space = box(across: 200mm, up: 50mm, deep: 200mm)
  part floor : pine_19 {
    length: space.across
    width:  space.deep
    place {
      against(base.top)
      flush(base.left)
      flush(base.front)
    }
  }
}

assembly tray : Tray { }
