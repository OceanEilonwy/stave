// expect: error[motion] lid.panel hits back when lid is opened past 109.9deg
// fix: patch "Open no further than 109.9deg" { set Lid.hinges.opening_angle = 109.9deg }
stave 1

// The lid is set 10mm in from the 19mm back (its 9mm leaves still sit on
// the back), so its hinge pins sit on top of the back instead of just
// outside its outside edge: past upright, its back edge drops onto it.

project "Lid hits the back" {
  units: mm
}

stock pine_12 { species: pine, form: solid, thickness: 12mm, max_length: 2400mm }
stock pine_19 { species: pine, form: solid, thickness: 19mm, max_length: 2400mm }

part base : pine_12 {
  length: 300mm
  width:  200mm
  place {
    ground
  }
}

part back : pine_19 {
  length: 300mm
  width:  100mm
  place {
    orient(length: right, width: up)
    against(base.top)
    flush(base.left)
    flush(base.back)
  }
}

region outline = opening(
  left:   base.left,
  right:  base.right,
  bottom: base.bottom,
  top:    back.top,
  front:  base.front,
  back:   base.back,
)

component Lid {
  param outline  : Region
  param hinge_on : Part

  part panel : pine_12 {
    length: outline.across
    width:  outline.deep - 10mm
    place {
      against(outline.top)
      flush(outline.left)
      flush(outline.front)
    }
  }

  hardware hinges[left, right] : butt_hinge(panel, on: hinge_on, face: bottom, length: 30mm) {
    place {
      spaced(ends(inset: 30mm), from: panel.left, to: panel.right)
    }
  }
}

assembly lid : Lid {
  outline:  outline
  hinge_on: back
}
