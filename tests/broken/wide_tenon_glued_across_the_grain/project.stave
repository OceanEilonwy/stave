// expect: warning[grain] tenons: apron is glued across its grain to leg over 130mm in the mortise, and wood held that wide splits as it moves with the seasons
stave 1

// A wide apron tenoned and glued into a leg (audit finding 89). The
// apron's grain runs along it, so it swells and shrinks up and down; the
// leg's grain runs up and down, so it holds still that way. With 10mm
// shoulders the tenon is 130mm wide, and its glued cheeks hold the apron
// still across 130mm of its grain: more than the 80mm oak allows.

project "Wide tenon glued across the grain" {
  units: mm
}

stock oak    { species: white_oak, form: solid, thickness: 19mm, max_width: 500mm, max_length: 2400mm }
stock oak_45 { species: white_oak, form: solid, thickness: 45mm, width: 45mm, max_length: 2400mm }

part leg : oak_45 {
  length: 700mm
  place {
    ground
    orient(length: down, width: right)
  }
}

part apron : oak {
  length: 300mm
  width:  150mm
  place {
    orient(length: right, width: up)
    against(leg.right)
    flush(leg.top)
    center(leg, deep)
  }
}

joint tenons : mortise_tenon(apron, into: leg, thickness: 8mm, length: 20mm)
