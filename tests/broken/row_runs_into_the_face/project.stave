// expect: error[type-mismatch] pins: the row of side holes runs right, into side_l
stave 1

project "A row into the face" {
  units: mm
}

stock pine_19 { species: pine, form: solid, thickness: 19mm, max_width: 300mm, max_length: 2400mm }

part side_l : pine_19 {
  length: 900mm
  width:  280mm
  place {
    ground
    orient(length: up, width: back)
  }
}

part side_r : pine_19 {
  length: 900mm
  width:  280mm
  place {
    orient(length: up, width: back)
    against(side_l.right, gap: 600mm)
    flush(side_l.bottom)
    flush(side_l.front)
  }
}

part bottom : pine_19 {
  length: fit
  width:  280mm
  place {
    flush(side_l.bottom)
    center(from: side_l.right, to: side_r.left)
    flush(side_l.front)
  }
}

joint bottom_dowels : dowel(bottom, into: [side_l, side_r], count: 2)

/// The shelf: 1mm clear of each side, so it lifts out.
part shelf : pine_19 {
  length: 598mm
  width:  260mm
  place {
    flush(side_l.bottom, inset: 400mm)
    center(from: side_l.right, to: side_r.left)
    flush(side_l.front, inset: 10mm)
  }
}

kind side_pin : support {
  roles {
    piece: Part
    shelf: Part
  }
  mount {
    face:   face(piece, toward: shelf)
    across: open
    along:  open
  }
  member shank {
    with:  piece
    shape: cylinder(diameter: 5mm, depth: 0mm..8mm)
  }
  member peg {
    with:  shelf
    shape: cylinder(diameter: 5mm, depth: -8mm..0mm)
  }
  // right runs into side_l, not along its face.
  cut side_hole: row(crossing(piece, shank), pitch: 32mm, right: 2) {
    drill(diameter: 5mm, depth: 8mm, wall: 0mm)
  }
}

hardware pins : side_pin(side_l, shelf: shelf) {
  place {
    flush(shelf.front, inset: 40mm)
    against(shelf.bottom)
  }
}
