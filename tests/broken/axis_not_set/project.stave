// expect: error[axis-not-set] shelf: position along 'deep' is not set
stave 1

// Nothing says where the shelf sits from front to back.

project "Axis not set" {
  units: mm
}

stock pine_19 { species: pine, form: solid, thickness: 19mm, max_length: 2400mm }

part base : pine_19 {
  length: 600mm
  width:  300mm
  place {
    ground
  }
}

part shelf : pine_19 {
  length: 400mm
  width:  300mm
  place {
    against(base.top, gap: 200mm)
    center(base, across)
  }
}
