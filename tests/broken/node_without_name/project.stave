// expect: error[type-mismatch] 'node' needs the name of one node
stave 1

project "A knob with no node" {
  units: mm
}

param overall_width = 600mm
param overall_depth = 300mm

region envelope = box(across: overall_width, up: 400mm, deep: overall_depth)

stock pine_19 { species: pine, form: solid, thickness: 19mm, max_length: 2400mm }

part base : pine_19 {
  length: overall_width
  width:  overall_depth
  place {
    flush(envelope.bottom)
    flush(envelope.left)
    flush(envelope.front)
  }
}

kind plain_knob : pull {
  roles {
    piece: Part
  }
  model: model("./knob.glb", align: node())

  mount {
    face:   front
    across: open
    along:  open
  }

  member body {
    with:  piece
    shape: cylinder(diameter: 26mm, depth: -30mm..0mm)
  }
}
