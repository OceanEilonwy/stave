// expect: error[type-mismatch] one label isn't an array: 'only' is the only label of 'shelf'
stave 1

// Two or more names in brackets are labels; a single label isn't an
// array: the shelf should just be named.

project "One label" {
  units: mm
}

stock oak { species: white_oak, form: solid, thickness: 19mm, max_width: 300mm, max_length: 2400mm }

part shelf[only] : oak {
  length: 600mm
  width:  200mm
  place { ground }
}
