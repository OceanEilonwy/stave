// expect: error[motion] door's hardware doesn't move alike
stave 1

// A door hung on one cup hinge and one butt hinge. A cup hinge moves the
// door forward and out on its links as it turns; a butt hinge turns it
// about the pin on its edge. Both can't hold one door: whichever moves it,
// the other binds. Every hinge on one door must move it the same way.

project "Hinges move differently" {
  units: mm
}

stock ply_18 { species: birch, form: plywood, thickness: 18mm, max_length: 2440mm }

part base : ply_18 {
  length: 600mm
  width:  400mm
  place {
    ground
  }
}

part side_l : ply_18 {
  length: 700mm
  width:  400mm
  place {
    orient(length: up, width: back)
    against(base.top)
    flush(base.left)
    flush(base.back)
  }
}

part side_r = mirror(side_l, about: mid(base, across))

region bay = opening(
  left:   side_l.right,
  right:  side_r.left,
  bottom: base.top,
  top:    side_l.top,
  front:  base.front,
  back:   base.back,
)

component Door {
  param opening    : Region
  param hinge_side : Part

  region face = cover(opening, overlay(left: 18mm, right: 18mm), thickness: ply_18.thickness)

  part panel : ply_18 {
    length: face.up
    width:  face.across
    place {
      orient(length: up, width: right)
      flush(face.left)
      flush(face.bottom)
      flush(face.front)
    }
  }

  hardware cup : euro_hinge(panel, on: hinge_side) {
    place {
      flush(panel.bottom, inset: 80mm)
    }
  }

  hardware pin : butt_hinge(panel, on: hinge_side) {
    place {
      flush(panel.top, inset: 80mm)
    }
  }
}

assembly door : Door {
  opening:    bay
  hinge_side: side_l
}
