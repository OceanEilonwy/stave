// expect: error[out-of-range] j: it places no screws, so nothing joins its parts
stave 1

// No screws and no glue: nothing would hold the apron to the leg.

project "No screws" {
  units: mm
}

stock oak   { species: white_oak, form: solid, thickness: 19mm, max_width: 300mm, max_length: 2400mm }
stock leg45 { species: white_oak, form: solid, thickness: 45mm, width: 45mm, max_length: 2400mm }

part leg : leg45 {
  length: 700mm
  place {
    ground
    orient(length: up, width: right)
  }
}

part apron : oak {
  length: 400mm
  width:  90mm
  place {
    orient(length: right, width: up)
    against(leg.right)
    flush(leg.top)
    center(leg, deep)
  }
}

joint j : screw(apron, into: leg, count: 0, glue: false)
