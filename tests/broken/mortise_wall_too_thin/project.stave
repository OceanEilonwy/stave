// expect: error[require] 'mortise_wall' fails: the mortise comes too close to a face of the part or another cut
stave 1

// The side table's aprons with shoulder: 0.5mm: each apron is flush with
// the top of the legs, so its mortise stops 0.5mm below the top of its leg,
// a wall of end grain that breaks away as soon as the tenon goes in
// (docs/reviews/2026-11-17-checks-gaps.md, gap 4, "the 0.5mm mortise
// wall"; the review's way to it, an 18mm tenon at a 0mm setback, is now
// caught by mortise_tenon's tenon_thin rule first).

project "A mortise wall too thin" {
  units: mm
}

stock oak_19    { species: white_oak, form: solid, thickness: 19mm }
stock oak_45_sq { species: white_oak, form: solid, thickness: 45mm, width: 45mm }

part leg_l : oak_45_sq {
  length: 575mm
  place {
    ground
    orient(length: up, width: right)
  }
}

part leg_r : oak_45_sq {
  length: 575mm
  place {
    orient(length: up, width: right)
    against(leg_l.right, gap: 400mm)
    flush(leg_l.bottom)
    flush(leg_l.front)
  }
}

part apron : oak_19 {
  length: between(leg_l, leg_r)
  width:  90mm
  place {
    orient(length: right, width: up)
    against(leg_l.right)
    flush(leg_l.top)
    flush(leg_l.front, inset: 5mm)
  }
}

joint apron_tenons : mortise_tenon(apron, into: [leg_l, leg_r], length: 20mm, shoulder: 0.5mm)
