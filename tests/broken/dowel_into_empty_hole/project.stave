// expect: error[require] 'hole_wall' fails: the dowel hole comes too close to a face of the board or another cut
stave 1

// A side stands on the base on a dowel, and a joint bores an empty 16mm
// hole into the base from below, right under the side's pin. The
// hole has nothing in it, so the pin running into it is air, not an
// overlap; the dowel's own wall rule now measures the wood between its
// hole and the empty one (docs/reviews/2026-11-17-checks-gaps.md, stage 2's
// open case).

project "A dowel into an empty hole" {
  units: mm
}

/// An empty hole, and nothing else.
kind bored : joint {
  insert: [push(piece, along: length)]
  cut bore: crossing(into, piece) { drill(diameter: 16mm, depth: 12mm) }
}

stock oak_19 { species: white_oak, form: solid, thickness: 19mm }

part base : oak_19 {
  length: 600mm
  width:  300mm
  place {
    ground
  }
}

part side : oak_19 {
  length: 400mm
  width:  300mm
  place {
    orient(length: up, width: back)
    against(base.top)
    flush(base.left)
    flush(base.back)
  }
}

part foot : oak_19 {
  length: 60mm
  width:  19mm
  place {
    orient(length: back, width: right)
    against(base.bottom)
    flush(base.left)
    center(base, deep)
  }
}

joint side_dowels : dowel(side, into: base, count: 1)
joint foot_bore   : bored(foot, into: base)
