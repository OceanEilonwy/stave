// expect: error[out-of-range] a 120mm arch is too big for apron: it is only 110mm wide
stave 1

// An arch that rises higher than the apron is wide would cut it in two.

project "Arch too high" {
  units: mm
}

stock oak_19 { species: white_oak, form: solid, thickness: 19mm, max_width: 200mm, max_length: 2400mm }

part apron : oak_19 {
  length: 800mm
  width:  110mm
  shape:  arched(rise: 120mm, on: bottom)
  place {
    orient(length: right, width: up)
    ground
  }
}
