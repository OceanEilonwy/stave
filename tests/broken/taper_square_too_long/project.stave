// expect: error[out-of-range] leg stays square for 710mm, which is all of its 710mm length, so nothing is tapered
stave 1

// A leg left square for its whole length has nothing left to taper.

project "Taper square too long" {
  units: mm
}

stock oak_45_sq { species: white_oak, form: solid, thickness: 45mm, width: 45mm, max_length: 2400mm }

part leg : oak_45_sq {
  length: 710mm
  shape:  tapered(to: 25mm, toward: bottom, on: right, square: 710mm)
  place {
    orient(length: up, width: right)
    ground
  }
}
