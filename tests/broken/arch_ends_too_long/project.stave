// expect: error[out-of-range] apron's straight ends take 800mm of its 800mm length, so nothing is arched
stave 1

// Straight ends that take the whole length leave no arch.

project "Arch ends too long" {
  units: mm
}

stock oak_19 { species: white_oak, form: solid, thickness: 19mm, max_width: 200mm, max_length: 2400mm }

part apron : oak_19 {
  length: 800mm
  width:  110mm
  shape:  arched(rise: 30mm, on: bottom, ends: 400mm)
  place {
    orient(length: right, width: up)
    ground
  }
}
