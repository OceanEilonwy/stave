// expect: error[duplicate-name] right is tapered twice
stave 1

// Naming a face twice is a slip: each face is planed once.

project "Taper face twice" {
  units: mm
}

stock oak_45_sq { species: white_oak, form: solid, thickness: 45mm, width: 45mm, max_length: 2400mm }

part leg : oak_45_sq {
  length: 710mm
  shape:  tapered(to: 25mm, toward: bottom, on: [right, back, right])
  place {
    orient(length: up, width: right)
    ground
  }
}
