// expect: error[overlap] shelf and side_l overlap
stave 1

// A home-made dado sized for 18mm plywood, used for a 19mm pine shelf: the
// shelf is 1mm thicker than the dados it is meant to slide into.

project "Shelf thicker than its dado" {
  units: mm
}

stock pine_19 { species: pine, form: solid, thickness: 19mm }

part base : pine_19 {
  length: 600mm
  width:  300mm
  place {
    ground
  }
}

part side_l : pine_19 {
  length: 500mm
  width:  300mm
  place {
    orient(length: up, width: back)
    against(base.top)
    flush(base.left)
    flush(base.front)
  }
}

part side_r = mirror(side_l, about: mid(base, across))

part shelf : pine_19 {
  length: fit
  width:  300mm
  place {
    flush(base.top, inset: -250mm)
    center(base, across)
    flush(base.front)
  }
}

/// A dado of a fixed width, for 18mm plywood.
kind ply_dado : joint {
  param width = 18mm
  param depth = 6mm

  insert:    [push(piece, along: width)]
  cut_first: into
  adds:      extend(piece, by: depth)

  cut crossing(into, piece) {
    slot(width: width, depth: depth)
  }
}

joint shelf_dados : ply_dado(shelf, into: [side_l, side_r])
