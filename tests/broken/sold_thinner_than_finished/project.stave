// expect: error[out-of-range] oak_19 is sold 16mm thick, thinner than its finished thickness of 19mm
stave 1

// Boards can be planed thinner, never thicker.

project "Sold thinner than finished" {
  units: mm
}

stock oak_19 { species: white_oak, form: solid, thickness: 19mm, sold: 16mm, max_width: 200mm, max_length: 1800mm }

part rail : oak_19 {
  length: 600mm
  width:  90mm
  place {
    ground
  }
}
