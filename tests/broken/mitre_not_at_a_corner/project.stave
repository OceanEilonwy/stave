// expect: error[type-mismatch] middle: its parts don't cross at an end of each, so they make no corner to cut on the diagonal
stave 1

// A rail mitred into the middle of a stile. A mitre joins two parts at a
// corner, each running to the outside of it; here the rail crosses the
// stile half way along, so there is no corner and no diagonal to cut.

project "Mitre in the middle" {
  units: mm
}

stock oak_19 { species: white_oak, form: solid, thickness: 19mm, max_length: 2700mm }

part stile : oak_19 {
  length: 400mm
  width:  50mm
  place {
    orient(length: back, width: right)
    ground
  }
}

part rail : oak_19 {
  length: 300mm
  width:  50mm
  place {
    flush(stile.left)
    flush(stile.bottom)
    flush(stile.front, inset: 150mm)
  }
}

joint middle : mitre(rail, into: stile)
