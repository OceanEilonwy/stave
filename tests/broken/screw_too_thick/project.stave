// expect: error[require] 'seat_wide' fails: the parts overlap too little for screws this thick
stave 1

// The wall shelf's screws made 30mm thick: a screw that size needs more
// than the 19mm edge of a bracket arm to sit in without splitting it.

project "Screws too thick" {
  units: mm
}

stock pine_19    { species: pine, form: solid, thickness: 19mm, max_length: 2400mm }
stock pine_strip { species: pine, form: solid, thickness: 19mm, width: 40mm, max_length: 2400mm }

part shelf : pine_19 {
  length: 600mm
  width:  150mm
  place {
    ground
  }
}

part arm[left, right] : pine_strip {
  length: 140mm
  place {
    orient(length: back, width: up)
    against(shelf.bottom)
    flush(shelf.back)
    spaced(ends(inset: 60mm), from: shelf.left, to: shelf.right)
  }
}

joint shelf_screws : screw(shelf, into: arm[*], length: 40mm, count: 2, diameter: 30mm, glue: false)
