// expect: error[motion] door.panel hits side_l when door is opened past 90.1deg
stave 1

// The sides stand 40mm proud of the front of the cabinet, and the door
// hangs between them (2mm clear of the latch side) on hinges that open to
// 110 degrees: once it is square to the front, it swings back into the side
// it is hinged on.

project "Door hits the side" {
  units: mm
}

stock ply_18 { species: birch, form: plywood, thickness: 18mm }

part base : ply_18 {
  length: 600mm
  width:  400mm
  place {
    ground
  }
}

part side_l : ply_18 {
  length: 700mm
  width:  440mm
  place {
    orient(length: up, width: back)
    against(base.top)
    against(base.left)
    flush(base.back)
  }
}

part side_r = mirror(side_l, about: mid(base, across))

region bay = opening(
  left:   side_l.right,
  right:  side_r.left,
  bottom: base.top,
  top:    side_l.top,
  front:  base.front,
  back:   base.back,
)

component Door {
  param opening    : Region
  param hinge_side : Part

  region face = cover(opening, overlay(right: -2mm), thickness: ply_18.thickness)

  part panel : ply_18 {
    length: face.up
    width:  face.across
    place {
      orient(length: up, width: right)
      flush(face.left)
      flush(face.bottom)
      flush(face.front)
    }
  }

  hardware hinges[bottom, top] : euro_hinge(panel, on: hinge_side) {
    place {
      spaced(ends(inset: 80mm), from: panel.bottom, to: panel.top)
    }
  }
}

assembly door : Door {
  opening:    bay
  hinge_side: side_l
}
