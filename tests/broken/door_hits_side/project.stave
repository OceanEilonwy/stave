// expect: error[motion] door.panel hits wall when door is opened past 0.6deg
// fix: patch "Use left: 16mm" { set Door.face = cover(opening, overlay(left: 16mm, right: 17.8mm), thickness: ply_18.thickness) }
stave 1

// The cabinet stands against a wall that reaches as far forward as the
// door, and the door covers the side it is hinged on almost to the wall
// (0.2mm clear). A cup hinge doesn't turn the door about its edge: it
// pushes the door out and swings its hinge edge sideways by about a
// millimetre as it opens, into the wall.

project "Door hits the side" {
  units: mm
}

stock ply_18 { species: birch, form: plywood, thickness: 18mm, max_length: 2440mm }

part base : ply_18 {
  length: 600mm
  width:  400mm
  place {
    ground
  }
}

part side_l : ply_18 {
  length: 700mm
  width:  400mm
  place {
    orient(length: up, width: back)
    against(base.top)
    flush(base.left)
    flush(base.back)
  }
}

/// The wall beside the cabinet, as far forward as the front of the door.
part wall : ply_18 {
  length: 800mm
  width:  418mm
  place {
    orient(length: up, width: back)
    against(base.top)
    against(side_l.left)
    flush(base.back)
  }
}

part side_r = mirror(side_l, about: mid(base, across))

region bay = opening(
  left:   side_l.right,
  right:  side_r.left,
  bottom: base.top,
  top:    side_l.top,
  front:  base.front,
  back:   base.back,
)

component Door {
  param opening    : Region
  param hinge_side : Part

  region face = cover(opening, overlay(left: 17.8mm, right: 17.8mm), thickness: ply_18.thickness)

  part panel : ply_18 {
    length: face.up
    width:  face.across
    place {
      orient(length: up, width: right)
      flush(face.left)
      flush(face.bottom)
      flush(face.front)
    }
  }

  hardware hinges[bottom, top] : euro_hinge(panel, on: hinge_side) {
    place {
      spaced(ends(inset: 80mm), from: panel.bottom, to: panel.top)
    }
  }
}

assembly door : Door {
  opening:    bay
  hinge_side: side_l
}
