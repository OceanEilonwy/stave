// expect: error[overlap] door_l and top overlap
stave 1

// The doors are given a 10mm overlay at the top, but the top overhangs the
// front of the cabinet just above the opening: both doors reach 10mm into
// it. The mistake is the mount, so that is where it is reported.

project "Door overlay into the top" {
  units: mm
}

stock ply_18 { species: birch, form: plywood, thickness: 18mm, max_length: 2440mm }

part base : ply_18 {
  length: 800mm
  width:  400mm
  place {
    ground
  }
}

part side_l : ply_18 {
  length: 700mm
  width:  400mm
  place {
    orient(length: up, width: back)
    against(base.top)
    flush(base.left)
    flush(base.front)
  }
}

part side_r = mirror(side_l, about: mid(base, across))

/// The top overhangs the front by 30mm.
part top : ply_18 {
  length: 800mm
  width:  430mm
  place {
    against(side_l.top)
    flush(base.left)
    flush(base.back)
  }
}

region bay[left, right] = split(
  opening(
    left:   side_l.right,
    right:  side_r.left,
    bottom: base.top,
    top:    side_l.top,
    front:  base.front,
    back:   base.back,
  ),
  across,
)

assembly door_l : Door {
  opening:    bay[left]
  hinge_side: side_l
  mount:      overlay(left: 16mm, top: 10mm, bottom: 16mm, meeting: -1mm)
}

assembly door_r = mirror(door_l, about: mid(base, across))
