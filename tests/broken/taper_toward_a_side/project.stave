// expect: error[type-mismatch] leg runs up and down, so its taper runs toward its top or its bottom, not right
stave 1

// A leg's taper runs along its length, so it runs toward one of its ends,
// never toward one of its long faces.

project "Taper toward a side" {
  units: mm
}

stock oak_45_sq { species: white_oak, form: solid, thickness: 45mm, width: 45mm, max_length: 2400mm }

part leg : oak_45_sq {
  length: 710mm
  shape:  tapered(to: 25mm, toward: right, on: [right, back])
  place {
    orient(length: up, width: right)
    ground
  }
}
