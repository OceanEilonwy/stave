// expect: warning[grain] top is held fast at places 201.5mm apart across its grain, so it can't swell and shrink with the seasons
stave 1

// A batten screwed across the underside of a solid top through round
// holes (audit finding 89): the batten's grain runs front to back, so it
// holds still the way the top moves, and its three screws pin the top at
// places 201.5mm apart across its grain.

project "Batten screwed across the grain" {
  units: mm
}

stock oak    { species: white_oak, form: solid, thickness: 19mm, max_width: 500mm, max_length: 2400mm }
stock oak_25 { species: white_oak, form: solid, thickness: 25mm, max_width: 200mm, max_length: 2400mm }

part top : oak {
  length: 600mm
  width:  400mm
  place { ground }
}

part batten : oak_25 {
  length: 400mm
  width:  50mm
  place {
    orient(length: back, width: right)
    against(top.bottom)
    flush(top.left, inset: 50mm)
    flush(top.front)
  }
}

joint screws : screw(batten, into: top, length: 35mm, count: 3, glue: false)
