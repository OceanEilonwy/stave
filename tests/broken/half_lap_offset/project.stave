// expect: error[require] 'crosses_fully' fails: the parts must cross by their whole thickness for the laps to meet
stave 1

// b is lifted 8mm out of a, so the two sticks cross by 12mm instead of
// their whole 20mm. Each half lap still cuts 10mm deep, so the lap faces
// stand 8mm apart and the parts meet only in a thin strip of the cheeks.
project "S" { }
stock oak { species: white_oak, form: solid, thickness: 20mm, max_width: 300mm, max_length: 2400mm }
part a : oak {
  length: 600mm
  width:  60mm
  place { ground }
}
part b : oak {
  length: 600mm
  width:  60mm
  place {
    orient(length: back, width: right)
    flush(a.bottom, inset: 8mm)
    center(a, across)
    center(a, deep)
  }
}
joint lap : half_lap(b, into: a)
