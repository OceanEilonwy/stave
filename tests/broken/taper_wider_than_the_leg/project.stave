// expect: error[out-of-range] leg can't be tapered to 50mm: it is only 45mm wide
stave 1

// Tapering a 45mm leg "to" 50mm would make it bigger, not smaller.

project "Taper wider than the leg" {
  units: mm
}

stock oak_45_sq { species: white_oak, form: solid, thickness: 45mm, width: 45mm, max_length: 2400mm }

part leg : oak_45_sq {
  length: 710mm
  shape:  tapered(to: 50mm, toward: bottom, on: right)
  place {
    orient(length: up, width: right)
    ground
  }
}
