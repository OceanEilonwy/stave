// expect: error[overlap] rail and leg overlap
stave 1

// A home-made mortise and tenon whose mortise is cut shallower than the
// tenon is long: "length - relief" was written where "length + relief" was
// meant, so the tenon bottoms out 3mm past the floor of its mortise.

project "Tenon too long" {
  units: mm
}

stock oak_19    { species: white_oak, form: solid, thickness: 19mm }
stock oak_45_sq { species: white_oak, form: solid, thickness: 45mm, width: 45mm }

part leg : oak_45_sq {
  length: 400mm
  place {
    ground
    orient(length: up, width: right)
  }
}

part rail : oak_19 {
  length: 300mm
  width:  60mm
  place {
    orient(length: right, width: up)
    against(leg.right)
    flush(leg.top)
    center(leg, deep)
  }
}

/// A mortise and tenon with a mistake in its mortise depth.
kind my_tenon : joint {
  param length = 25mm
  param relief = 3mm

  insert:    [push(piece, along: length)]
  cut_first: into
  adds:      extend(piece, by: length)

  cut tenon: end(piece, facing: into) {
    tenon(length: length, width: piece.width - 20mm, thickness: piece.thickness / 3)
  }
  cut mortise: crossing(into, piece) {
    pocket(width: piece.width - 20mm, thickness: piece.thickness / 3, depth: length - relief)
  }
}

joint rail_tenon : my_tenon(rail, into: leg)
