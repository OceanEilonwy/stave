// expect: error[type-mismatch] 'housed' would make board thicker: board meets base with its face, but extend lengthens an end or an edge
stave 1

project "A board laid on a board" {
  units: mm
}

stock oak { species: white_oak, form: solid, thickness: 19mm, max_width: 300mm, max_length: 2400mm }

part base : oak {
  length: 600mm
  width:  300mm
  place { ground }
}

// The board lies flat on the base, so a rabbet's extension would go
// through its face and make it 28.5mm thick from 19mm oak.
part board : oak {
  length: 400mm
  width:  200mm
  place {
    against(base.top)
    center(base, across)
    center(base, deep)
  }
}

joint housed : rabbet(board, into: base)
