// expect: error[out-of-range] 'resolution' must be more than 0mm, found 0mm
stave 1

// Sizes can't be rounded to the nearest nothing.

project "Resolution of nothing" {
  units:      mm
  resolution: 0mm
}

stock oak { species: white_oak, form: solid, thickness: 19mm, max_width: 300mm, max_length: 2400mm }

part shelf : oak {
  length: 600mm
  width:  200mm
  place { ground }
}
