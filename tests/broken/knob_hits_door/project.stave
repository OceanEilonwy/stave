// expect: error[motion] door_r.panel hits door_l.handle when door_r is opened past 106.8deg
stave 1

// Two bays side by side, each door hinged on its left. The left door's knob
// sits 20mm from its right edge, next to the right door's hinges: opened
// wide, the right door swings back into it.

project "Door hits a knob" {
  units: mm
}

stock ply_18 { species: birch, form: plywood, thickness: 18mm }

part base : ply_18 {
  length: 900mm
  width:  400mm
  place {
    ground
  }
}

part side_l : ply_18 {
  length: 700mm
  width:  400mm
  place {
    orient(length: up, width: back)
    against(base.top)
    flush(base.left)
    flush(base.front)
  }
}

part side_r = mirror(side_l, about: mid(base, across))

part divider : ply_18 {
  length: 700mm
  width:  400mm
  place {
    orient(length: up, width: back)
    against(base.top)
    center(base, across)
    flush(base.front)
  }
}

region bay_l = opening(
  left:   side_l.right,
  right:  divider.left,
  bottom: base.top,
  top:    side_l.top,
  front:  base.front,
  back:   base.back,
)

region bay_r = opening(
  left:   divider.right,
  right:  side_r.left,
  bottom: base.top,
  top:    side_l.top,
  front:  base.front,
  back:   base.back,
)

component Door {
  param opening    : Region
  param hinge_side : Part
  param mount      : Mount
  param plate      = 0mm                 // the hinge plates' height: 9mm where a door covers half the divider

  region face = cover(opening, mount, thickness: ply_18.thickness)

  part panel : ply_18 {
    length: face.up
    width:  face.across
    place {
      orient(length: up, width: right)
      flush(face.left)
      flush(face.bottom)
      flush(face.front)
    }
  }

  hardware hinges[bottom, top] : euro_hinge(panel, on: hinge_side, plate_height: plate) {
    place {
      spaced(ends(inset: 80mm), from: panel.bottom, to: panel.top)
    }
  }

  hardware handle : knob(panel, diameter: 30mm, projection: 40mm) {
    place {
      center(panel, up)
      flush(panel.right, inset: 5mm)
    }
  }
}

assembly door_l : Door {
  opening:    bay_l
  hinge_side: side_l
  mount:      overlay(left: 16mm, right: 8mm, bottom: 16mm)
}

assembly door_r : Door {
  opening:    bay_r
  hinge_side: divider
  mount:      overlay(left: 8mm, right: 16mm, bottom: 16mm)
  plate:      9mm
}
