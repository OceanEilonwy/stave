// expect: error[missing-field] member 'cup' is missing 'shape'
stave 1

project "Member without a shape" {
  units: mm
}

stock oak_19 { species: white_oak, form: solid, thickness: 19mm, max_length: 2700mm }

/// A hinge whose cup is named but not drawn: every member is drawn and
/// checked, so every member says what it is made of.
kind small_hinge : hinge {
  roles {
    piece: Part
    on:    Part
  }
  opening_angle: 110deg
  mount {
    face:   back
    across: from(edge(piece, nearer: on), inset: 22.5mm)
    along:  open
  }

  /// The plate, on the side.
  member plate {
    with:  on
    shape: box(along: 50mm, across: -5mm..6mm, depth: -55mm..-19mm)
  }
  /// The cup, in the door.
  member cup
}

part base : oak_19 {
  length: 400mm
  width:  300mm
  place {
    ground
  }
}
