// expect: error[wall] side_pegs: its peg hole in base breaks out of the left end of base
stave 1

// A kind with no rule of its own about the wood round its hole: a 30mm
// hole centred under a 19mm side standing on the very end of the base runs
// out of the base's end. The engine's backstop catches it: a drill never
// breaks out of a face it isn't aimed at.

project "A hole that breaks out" {
  units: mm
}

/// A big peg hole, and nothing else: no rules.
kind big_peg : joint {
  insert: [push(piece, along: length)]
  cut peg_hole: crossing(into, piece) { drill(diameter: 30mm, depth: 10mm) }
}

stock oak_19 { species: white_oak, form: solid, thickness: 19mm }

part base : oak_19 {
  length: 600mm
  width:  300mm
  place {
    ground
  }
}

part side : oak_19 {
  length: 400mm
  width:  300mm
  place {
    orient(length: up, width: back)
    against(base.top)
    flush(base.left)
    flush(base.back)
  }
}

joint side_pegs : big_peg(side, into: base)
