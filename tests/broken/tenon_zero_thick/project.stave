// expect: error[cut-size] j: its tenon on apron is 0mm thick
stave 1

// A tenon 0mm thick: the 20mm the joint adds to the apron would all be cut away, leaving its end 20mm clear of the leg.

project "A tenon with no thickness" {
  units: mm
}

stock oak   { species: white_oak, form: solid, thickness: 19mm, max_width: 300mm, max_length: 2400mm }
stock leg45 { species: white_oak, form: solid, thickness: 45mm, width: 45mm, max_length: 2400mm }

part leg : leg45 {
  length: 700mm
  place {
    ground
    orient(length: up, width: right)
  }
}

part apron : oak {
  length: 400mm
  width:  90mm
  place {
    orient(length: right, width: up)
    against(leg.right)
    flush(leg.top)
    center(leg, deep)
  }
}

joint j : mortise_tenon(apron, into: leg, thickness: 0mm, length: 20mm)
