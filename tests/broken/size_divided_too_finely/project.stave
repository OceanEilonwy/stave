// expect: error[out-of-range] a size here is too large, or divided too finely, for Stave to work out exactly
stave 1

project "Gaps divided too finely" {
  units: mm
}

stock pine_19 { species: pine, form: solid, thickness: 19mm, max_length: 2400mm }

part base : pine_19 {
  length: 600mm
  width:  300mm
  place {
    ground
  }
}

// Each board sits on the one below with a gap that is a different prime
// fraction of a millimetre. Stave keeps every size exact, so the height of
// each board is a fraction whose bottom number is the product of all the
// primes below it; after a dozen boards it is too large to keep. That is
// reported at the gap where it happens, rather than leaving the design
// unbuilt without a word.

part board_1 : pine_19 {
  length: 600mm
  width:  300mm
  place {
    against(base.top, gap: 1mm / 101)
    flush(base.left)
    flush(base.front)
  }
}

part board_2 : pine_19 {
  length: 600mm
  width:  300mm
  place {
    against(board_1.top, gap: 1mm / 103)
    flush(base.left)
    flush(base.front)
  }
}

part board_3 : pine_19 {
  length: 600mm
  width:  300mm
  place {
    against(board_2.top, gap: 1mm / 107)
    flush(base.left)
    flush(base.front)
  }
}

