// expect: error[type-mismatch] apron's left is an end, so it can't be arched
stave 1

// An arch runs along the part's length, so it is sawn into a long face.

project "Arch on an end" {
  units: mm
}

stock oak_19 { species: white_oak, form: solid, thickness: 19mm, max_width: 200mm, max_length: 2400mm }

part apron : oak_19 {
  length: 800mm
  width:  110mm
  shape:  arched(rise: 30mm, on: left)
  place {
    orient(length: right, width: up)
    ground
  }
}
