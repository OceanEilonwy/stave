// expect: error[type-mismatch] panel: its grain runs across its width, and its width works out as 3000mm, which is more than its stock's max_length of 2400mm
stave 1

// The panel's grain runs across it, so every board in it is 3000mm long
// along the grain, but the oak comes no longer than 2400mm.

project "Grain across, longer than the stock" {
  units: mm
}

stock oak { species: white_oak, form: solid, thickness: 19mm, max_width: 200mm, max_length: 2400mm }

part panel : oak {
  length: 600mm
  width:  3000mm
  grain:  width
  place { ground }
}
