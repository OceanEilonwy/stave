// expect: error[out-of-range] 'kerf' must be 0mm or more, found -3mm
stave 1

// A saw cut takes wood away; it can't add any.

project "Kerf below zero" {
  units: mm
  kerf:  -3mm
}

stock oak_19 { species: white_oak, form: solid, thickness: 19mm, max_width: 200mm, max_length: 1800mm }

part rail : oak_19 {
  length: 600mm
  width:  90mm
  place {
    ground
  }
}
