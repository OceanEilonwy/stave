// expect: error[syntax] expected end of line, found 'locked'
stave 1

project "Locked written last" {
  units: mm
}

// Draft 3 wrote 'locked' after the value. It now comes first:
// locked param reveal = 1.5mm
param reveal = 1.5mm locked

stock pine_19 { species: pine, form: solid, thickness: 19mm, max_length: 2400mm }

part base : pine_19 {
  length: 600mm
  width:  300mm
  place {
    ground
  }
}
