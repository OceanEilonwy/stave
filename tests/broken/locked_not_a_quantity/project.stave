// expect: error[type-mismatch] 'locked' needs a length, an angle, a ratio or a count, found a stock
stave 1

project "Locked stock" {
  units: mm
}

stock pine_19 { species: pine, form: solid, thickness: 19mm, max_length: 2400mm }

// Only a size or a number can be locked or solved.
locked param top_stock : Stock = pine_19

part base : top_stock {
  length: 600mm
  width:  300mm
  place {
    ground
  }
}
