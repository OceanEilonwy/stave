// expect: error[hinge-overlay] door.hinges[bottom]: door.panel overlays side_l by 9mm, but the hinge gives 15.5mm to 19.5mm
stave 1

// A door that covers only half of the side it is hinged on, on cup hinges
// with 0mm plates. A full-overlay cup hinge holds its door over the side
// by 12.5mm plus the boring distance (5mm), give or take 2mm on the arm's
// side screw: this door is too far out. A 9mm plate would hold it.

project "Hinge overlay" {
  units: mm
}

stock ply_18 { species: birch, form: plywood, thickness: 18mm }

part base : ply_18 {
  length: 600mm
  width:  400mm
  place {
    ground
  }
}

part side_l : ply_18 {
  length: 700mm
  width:  400mm
  place {
    orient(length: up, width: back)
    against(base.top)
    flush(base.left)
    flush(base.back)
  }
}

part side_r = mirror(side_l, about: mid(base, across))

region bay = opening(
  left:   side_l.right,
  right:  side_r.left,
  bottom: base.top,
  top:    side_l.top,
  front:  base.front,
  back:   base.back,
)

component Door {
  param opening    : Region
  param hinge_side : Part

  region face = cover(opening, overlay(left: 9mm, right: 9mm), thickness: ply_18.thickness)

  part panel : ply_18 {
    length: face.up
    width:  face.across
    place {
      orient(length: up, width: right)
      flush(face.left)
      flush(face.bottom)
      flush(face.front)
    }
  }

  hardware hinges[bottom, top] : euro_hinge(panel, on: hinge_side) {
    place {
      spaced(ends(inset: 80mm), from: panel.bottom, to: panel.top)
    }
  }
}

assembly door : Door {
  opening:    bay
  hinge_side: side_l
}
