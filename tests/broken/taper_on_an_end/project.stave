// expect: error[type-mismatch] leg's top is an end, so it can't be tapered
stave 1

// The top of a standing leg is an end grain face, not a face along it.

project "Taper on an end" {
  units: mm
}

stock oak_45_sq { species: white_oak, form: solid, thickness: 45mm, width: 45mm, max_length: 2400mm }

part leg : oak_45_sq {
  length: 710mm
  shape:  tapered(to: 25mm, toward: bottom, on: [right, top])
  place {
    orient(length: up, width: right)
    ground
  }
}
