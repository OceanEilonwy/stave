// expect: warning[loose-part] apron is loose: j is not glued and cuts or places nothing to hold it
stave 1

// Glued face to face, but with the glue left out: nothing holds the apron.

project "A joint that holds nothing" {
  units: mm
}

stock oak   { species: white_oak, form: solid, thickness: 19mm, max_width: 300mm, max_length: 2400mm }
stock leg45 { species: white_oak, form: solid, thickness: 45mm, width: 45mm, max_length: 2400mm }

part leg : leg45 {
  length: 700mm
  place {
    ground
    orient(length: up, width: right)
  }
}

part apron : oak {
  length: 400mm
  width:  90mm
  place {
    orient(length: right, width: up)
    against(leg.right)
    flush(leg.top)
    center(leg, deep)
  }
}

joint j : glued_face(apron, into: leg, glue: false)
