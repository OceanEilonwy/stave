// expect: error[unknown-field] a hinge kind has no member 'cupp'
stave 1

project "Misnamed member" {
  units: mm
}

stock oak_19 { species: white_oak, form: solid, thickness: 19mm }

/// A cup hinge whose last member is misspelt: a member without a body is
/// one of a hinge's words (a cup hinge's plate, arm, links and cup, a butt
/// hinge's leaves and pin).
kind small_hinge : hinge {
  roles {
    piece: Part
    on:    Part
  }
  opening_angle: 110deg
  mount {
    face:   back
    across: from(edge(piece, nearer: on), inset: 22.5mm)
    along:  open
  }

  /// The plate, on the side.
  member plate
  /// The cup, in the door.
  member cupp
}

part base : oak_19 {
  length: 400mm
  width:  300mm
  place {
    ground
  }
}
