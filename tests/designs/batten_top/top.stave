stave 1

// A wide top made of three boards in tongue and groove, held flat by two
// battens slid into dovetail housings underneath. Nothing is glued, so the
// top can move with the seasons.

project "Batten top" {
  goal:   "A tabletop of three oak boards, tongue and groove without glue, held flat by sliding dovetail battens"
  units:  mm
  boards: joined(by: [tongue_and_groove(glue: false), suitsuki_zan(batten_stock: oak_25, glue: false)])
}

stock oak_19 { species: white_oak, form: solid, thickness: 19mm, max_width: 150mm }
stock oak_25 { species: white_oak, form: solid, thickness: 25mm }

/// The top: 420mm across the grain, so it is made of three boards of 140mm.
part top : oak_19 {
  length: 600mm
  width:  420mm
  place {
    ground
  }
}
