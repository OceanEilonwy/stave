stave 1

// A wide top made of three boards held together by butterfly keys, with no
// glue in the seams. Each key is let into the top face across a seam.

project "Chigiri top" {
  goal:  "A tabletop of three oak boards joined by butterfly keys, without glue"
  units: mm
}

stock oak_19 { species: white_oak, form: solid, thickness: 19mm, max_width: 150mm, max_length: 2700mm }

/// The top: 420mm across the grain, so it is made of three boards of 140mm,
/// with a key across each of the two seams.
part top : oak_19 {
  length: 600mm
  width:  420mm
  boards: joined(by: chigiri(glue: false))
  place {
    ground
  }
}
