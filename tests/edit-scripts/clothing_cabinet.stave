stave 1

import "std:casework"

project "Clothing cabinet" {
  units: mm
  tools: [pencil, marking_knife, square, tape, marking_gauge, awl, calipers, tenon_saw, chisel, mallet, router_plane, clamps, screwdriver, router, straight_bit, drill, depth_stop, lathe, roughing_gouge, spindle_gouge, parting_tool]
}

param overall_width  = 940mm
param overall_height = 1780mm
param overall_depth  = 580mm

region envelope                = box(across: overall_width, up: overall_height, deep: overall_depth)
region drawer_bay[bottom, top] = split(divider.below, up)
region door_bay[left, right]   = split(divider.above, across)

stock oak_19       { species: white_oak, form: solid, thickness: 19mm, max_width: 200mm, max_length: 2700mm }
stock oak_6        { species: white_oak, form: solid, thickness: 6mm, max_width: 200mm, max_length: 2700mm }
stock maple_12     { species: hard_maple, form: solid, thickness: 12mm, max_width: 150mm, max_length: 2400mm }
stock ply_6        { species: birch, form: plywood, thickness: 6mm, max_length: 2440mm }
stock oak_dowel_28 { species: white_oak, form: dowel, diameter: 28mm }
stock oak_75_sq    { species: white_oak, form: solid, thickness: 75mm, width: 75mm, max_length: 2700mm }

assembly case : casework.Case {
  space:       envelope
  panel_stock: oak_19
  raise:       80mm
}

assembly back : casework.Back {
  sides:       [case.side[left], case.side[right]]
  stands_on:   case.base
  under:       case.top
  panel_stock: ply_6
}

assembly divider : casework.Divider {
  space:       back.in_front
  sides:       [case.side[left], case.side[right]]
  panel_stock: oak_19
  height:      500mm
}

assembly drawer[bottom, top] : casework.Drawer {
  opening:      drawer_bay[same]
  mount:        overlay(left: 18mm, right: 18mm, top: 8mm, bottom: 8mm, meeting: -2.5mm)
  front_stock:  oak_19
  box_stock:    maple_12
  bottom_stock: ply_6
  slide:        side_mount_slide(length: 500mm)
}

assembly door_left : casework.FramePanelDoor {
  opening:     door_bay[left]
  hinge_side:  case.side[left]
  mount:       overlay(left: 18mm, right: 18mm, top: -1.5mm, bottom: 8mm, meeting: -0.75mm)
  frame:       oak_19
  panel_stock: oak_6
}

assembly door_right = mirror(door_left, about: mid(divider.above, across))

assembly shelf : casework.Shelf {
  space:       divider.above
  sides:       [case.side[left], case.side[right]]
  panel_stock: oak_19
  headroom:    160mm
}

assembly rail : casework.HangingRail {
  under:      shelf.board
  sides:      [case.side[left], case.side[right]]
  rail_stock: oak_dowel_28
}

assembly feet : casework.Feet {
  under:      case.base
  foot_stock: oak_75_sq
}

require rail_to_divider_panel_min : between(rail.rail, divider.panel) >= 800mm "room for a coat on a hanger"
