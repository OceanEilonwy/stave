// expect: warning[loose-part] shelf is loose: no joint or hardware joins it to a part that stands on the floor
// pending: the parser does not read box(across:, up:, deep:) yet
stave 1

project "A shelf in the air" {
  units: mm
}

param overall_width  = 600mm
param overall_height = 400mm
param overall_depth  = 300mm

region envelope = box(across: overall_width, up: overall_height, deep: overall_depth)

stock pine_19 { species: pine, form: solid, thickness: 19mm, max_length: 2400mm }

part base : pine_19 {
  length: overall_width
  width:  overall_depth
  place {
    flush(envelope.bottom)
    flush(envelope.left)
    flush(envelope.front)
  }
}

// Nothing joins the shelf to base, which stands on the floor.
part shelf : pine_19 {
  length: overall_width
  width:  overall_depth
  place {
    flush(envelope.top)
    flush(envelope.left)
    flush(envelope.front)
  }
}
