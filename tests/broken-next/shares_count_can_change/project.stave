// expect: error[type-mismatch] 'shares' needs a fixed number of pieces, found a count that can change
// pending: the parser does not read 'shares:' yet
stave 1

project "Shares for a changing count" {
  units: mm
}

param overall_width  = 600mm
param overall_height = 400mm
param overall_depth  = 300mm

region envelope = box(across: overall_width, up: overall_height, deep: overall_depth)
param shelves = 2 within [2, 3]

region bay[shelves] = split(envelope, up, shares: [1, 2])

stock pine_19 { species: pine, form: solid, thickness: 19mm }

part base : pine_19 {
  length: overall_width
  width:  overall_depth
  place {
    flush(envelope.bottom)
    flush(envelope.left)
    flush(envelope.front)
  }
}
