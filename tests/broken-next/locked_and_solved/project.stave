// expect: error[syntax] expected 'param', found 'solved'
// pending: the parser does not read 'locked param' yet
stave 1

project "Locked and solved" {
  units: mm
}

// A param is locked or solved, not both.
locked solved param overall_width = 600mm within 500mm..700mm

stock pine_19 { species: pine, form: solid, thickness: 19mm, max_length: 2400mm }

part base : pine_19 {
  length: overall_width
  width:  300mm
  place {
    ground
  }
}
