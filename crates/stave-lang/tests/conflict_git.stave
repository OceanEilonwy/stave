stave 1

// Two new items added at the same place, written in git's style. Their
// names don't clash, so keeping both is offered.

project "Shelf" {
  goal:  "A small wall shelf"
  units: mm
}

stock oak_18 { species: oak, form: solid, thickness: 18mm, max_width: 200mm, max_length: 2400mm }

part shelf : oak_18 {
  length: 600mm
  width:  150mm
  place { ground }
}

