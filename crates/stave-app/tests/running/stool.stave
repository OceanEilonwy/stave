// A folding camp stool (docs/reviews/2026-11-22-turning-frames.md,
// appendix): the inner legs, with their rung, swing on a pivot bolt
// through each outer leg. Each inner leg turns beside its outer leg, so
// wood moves past wood (grammar, "Running clearance"): as written a 3mm
// steel washer on each bolt keeps them 3mm apart, more than the 0.375mm
// the two 30mm ash legs close up with the seasons and a running gap of
// 1mm.
stave 1

project "Folding Camp Stool" {
  goal: "An X-frame stool whose inner legs swing on a bolt through the outer legs"
}

region envelope = box(across: 400mm, up: 600mm, deep: 100mm)

stock ash_30 { species: ash, form: solid, thickness: 30mm, max_width: 200mm, max_length: 2400mm }
stock ash_25 { species: ash, form: solid, thickness: 25mm, max_width: 200mm, max_length: 2400mm }

part outer_leg_l : ash_30 {
  length: 600mm
  width:  45mm
  place {
    orient(length: up, width: back)
    flush(envelope.bottom)
    flush(envelope.left)
    center(envelope, deep)
  }
}

part outer_leg_r = mirror(outer_leg_l, about: mid(envelope, across))

part outer_rung : ash_25 {
  length: fit
  width:  30mm
  place {
    orient(length: right, width: up)
    flush(outer_leg_l.bottom, inset: 10mm)
    center(envelope, across)
    center(outer_leg_l, deep)
  }
}

part outer_seat_rail : ash_25 {
  length: fit
  width:  30mm
  place {
    orient(length: right, width: up)
    flush(outer_leg_l.top, inset: 10mm)
    center(envelope, across)
    center(outer_leg_l, deep)
  }
}

joint outer_tenons : mortise_tenon([outer_rung, outer_seat_rail], into: [outer_leg_l, outer_leg_r], length: 20mm)

kind pivot_bolt : fitting {
  roles {
    piece: Part     // the outer leg the bolt turns in
    into:  Part     // the inner leg
  }
  /// Diameter of the hand knob.
  param knob_diameter = 24mm
  /// How far the knob stands off the face.
  param projection = 8mm
  /// Diameter of the bolt.
  param bolt_diameter = 8mm
  /// How far the bolt goes into the inner leg, into a threaded insert.
  param thread_length = 15mm
  /// The steel washer the frame turns on, between the outer and the inner leg.
  param washer_thickness = 3mm
  param washer_diameter  = 30mm
  /// Wood left round the holes.
  param wall = 6mm
  /// How far the inner legs swing.
  param turn = 30deg
  /// How high up the outer leg the bolt goes through it.
  param height = 300mm

  // Nothing of the bolt rides on the upright, so the kind places it:
  // across the middle of the outer leg's face, at its height.
  mount {
    face:   front
    across: center(piece)
    along:  from(end(piece, toward: down), inset: height)
  }

  /// The bolt: through the upright, into a threaded insert in the stile.
  member bolt {
    with:  into
    shape: cylinder(diameter: bolt_diameter, depth: 0mm..piece.thickness + washer_thickness + thread_length)
  }
  /// The washer: the inner leg turns on it, steel on wood, clear of the outer leg.
  member washer {
    with:  bolt
    shape: cylinder(diameter: washer_diameter, depth: piece.thickness..piece.thickness + washer_thickness)
  }
  /// The knob: tighten to lock the stool open, loosen to fold it.
  member knob {
    with:  bolt
    shape: cylinder(diameter: knob_diameter, depth: -projection..0mm)
  }

  clamp knob, bolt along depth

  cut bolt_hole: crossing(piece, bolt) { drill(diameter: bolt_diameter + 2mm, depth: through, wall: wall) }
  cut insert_hole: crossing(into, bolt) { drill(diameter: bolt_diameter + 4mm, depth: thread_length, wall: wall) }

  mechanism {
    pins: depth
    pivot bolt, piece at point(along: 0mm, across: 0mm)
    drive: turn(bolt, from: 0deg, to: turn)
  }
}

component Legs {
  param stand_l : Part
  param stand_r : Part
  param washer  = 3mm

  part inner_leg_l : ash_30 {
    length: 500mm
    width:  45mm
    place {
      orient(length: up, width: back)
      flush(stand_l.bottom, inset: 50mm)
      against(stand_l.right, gap: washer)
      center(stand_l, deep)
    }
  }

  part inner_leg_r : ash_30 {
    length: 500mm
    width:  45mm
    place {
      orient(length: up, width: back)
      flush(stand_r.bottom, inset: 50mm)
      against(stand_r.left, gap: washer)
      center(stand_r, deep)
    }
  }

  part inner_rung : ash_25 {
    length: fit
    width:  30mm
    place {
      orient(length: right, width: up)
      flush(inner_leg_l.bottom, inset: 60mm)
      center(from: inner_leg_l.right, to: inner_leg_r.left)
      center(inner_leg_l, deep)
    }
  }

  joint inner_tenons : mortise_tenon(inner_rung, into: [inner_leg_l, inner_leg_r], length: 20mm)

  hardware pivot_l : pivot_bolt(stand_l, into: inner_leg_l, face: left, washer_thickness: washer)
  hardware pivot_r : pivot_bolt(stand_r, into: inner_leg_r, face: right, washer_thickness: washer)
}

assembly legs : Legs {
  stand_l: outer_leg_l
  stand_r: outer_leg_r
}
