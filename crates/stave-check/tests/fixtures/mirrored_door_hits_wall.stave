stave 1

// A pair of doors, the right one the mirror image of the left, in a
// cabinet that stands with its right side against a wall. The right door
// covers that side almost to the wall, and its hinge edge swings into the
// wall as it opens. That edge is the image of the left door's left edge.

project "Mirrored door hits the wall" {
  units: mm
}

stock ply_18 { species: birch, form: plywood, thickness: 18mm, max_length: 2440mm }

part base : ply_18 {
  length: 800mm
  width:  400mm
  place {
    ground
  }
}

part side_l : ply_18 {
  length: 700mm
  width:  400mm
  place {
    orient(length: up, width: back)
    against(base.top)
    flush(base.left)
    flush(base.back)
  }
}

part side_r = mirror(side_l, about: mid(base, across))

/// The wall beside the cabinet, as far forward as the front of the doors.
part wall : ply_18 {
  length: 800mm
  width:  418mm
  place {
    orient(length: up, width: back)
    against(base.top)
    against(side_r.right)
    flush(base.back)
  }
}

part divider : ply_18 {
  length: 700mm
  width:  400mm
  place {
    orient(length: up, width: back)
    against(base.top)
    center(base, across)
    flush(base.back)
  }
}

region bay_l = opening(
  left:   side_l.right,
  right:  divider.left,
  bottom: base.top,
  top:    side_l.top,
  front:  base.front,
  back:   base.back,
)

component Door {
  param opening    : Region
  param hinge_side : Part
  param mount      : Mount

  region face = cover(opening, mount, thickness: ply_18.thickness)

  part panel : ply_18 {
    length: face.up
    width:  face.across
    place {
      orient(length: up, width: right)
      flush(face.left)
      flush(face.bottom)
      flush(face.front)
    }
  }

  hardware hinges[bottom, top] : euro_hinge(panel, on: hinge_side) {
    place {
      spaced(ends(inset: 80mm), from: panel.bottom, to: panel.top)
    }
  }
}

assembly door_l : Door {
  opening:    bay_l
  hinge_side: side_l
  mount:      overlay(left: 17.8mm, right: 8mm)
}

assembly door_r = mirror(door_l, about: mid(base, across))
