---
source: crates/stave-ide/tests/tokens.rs
assertion_line: 378
expression: "render_project(& examples().join(\"side_table\"))"
---
== table.stave ==
   1 | stave 1
     = stave:keyword  1:number
  10 | project "Side table" {
     = project:keyword  ":text  Side table:text  ":text
  11 |   goal:       "A small oak side table with a lower shelf"
     = goal:field  ":text  A small oak side table with a lower shelf:text  ":text
  12 |   units:      mm
     = units:field  mm:word
  13 |   resolution: 0.5mm
     = resolution:field  0.5:number  mm:unit
  14 |   style:      "shaker"
     = style:field  ":text  shaker:text  ":text
  18 | param table_height = 600mm within 550mm..700mm
     = param:keyword  table_height:param+decl  600:number  mm:unit  within:keyword  550:number  mm:unit  700:number  mm:unit
  19 | param top_size     = 500mm within 400mm..600mm      // the top is square
     = param:keyword  top_size:param+decl  500:number  mm:unit  within:keyword  400:number  mm:unit  600:number  mm:unit
  20 | param shelf_height = 150mm within 100mm..200mm      // floor to the top of the stretchers
     = param:keyword  shelf_height:param+decl  150:number  mm:unit  within:keyword  100:number  mm:unit  200:number  mm:unit
  21 | let leg_inset = 25mm                                // from the edge of the top to the outside of a leg
     = let:keyword  leg_inset:let+decl  25:number  mm:unit
  22 | let setback   = 5mm                                 // aprons and stretchers sit this far in from the leg faces
     = let:keyword  setback:let+decl  5:number  mm:unit
  23 | let slat_gap  = 15mm                                // between neighbouring slats
     = let:keyword  slat_gap:let+decl  15:number  mm:unit
  26 | let slat_width = (top_size - 2 * (leg_inset + oak_45_sq.width) - 4 * slat_gap) / 5
     = let:keyword  slat_width:let+decl  top_size:param+ref  2:number  leg_inset:let+ref  oak_45_sq:stock+ref  width:plain  4:number  slat_gap:let+ref  5:number
  29 | require knee_room    : table_height - apron_front.width - top.thickness >= 380mm "leave room under the aprons for your knees"
     = require:keyword  knee_room:require+decl  table_height:param+ref  apron_front:part+ref  width:plain  top:part+ref  thickness:plain  380:number  mm:unit  ":text  leave room under the aprons for your knees:text  ":text
  30 | require shelf_clear  : between(slat[0], apron_front) >= 200mm "leave room above the shelf for a stack of books"
     = require:keyword  shelf_clear:require+decl  between:function  slat:part+ref  0:number  apron_front:part+ref  200:number  mm:unit  ":text  leave room above the shelf for a stack of books:text  ":text
  31 | require slats_strong : slat_width >= 40mm "narrow slats bend; make the top bigger or the gaps smaller"
     = require:keyword  slats_strong:require+decl  slat_width:let+ref  40:number  mm:unit  ":text  narrow slats bend; make the top bigger or the gaps smaller:text  ":text
  34 | stock oak_19    { species: white_oak, form: solid, thickness: 19mm, max_width: 200mm, max_length: 2700mm }
     = stock:keyword  oak_19:stock+decl  species:field  white_oak:word  form:field  solid:word  thickness:field  19:number  mm:unit  max_width:field  200:number  mm:unit  max_length:field  2700:number  mm:unit
  35 | stock oak_45_sq { species: white_oak, form: solid, thickness: 45mm, width: 45mm, max_length: 2700mm }
