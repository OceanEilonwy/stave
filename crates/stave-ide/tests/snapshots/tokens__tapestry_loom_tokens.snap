  76 |     center(upright_l, deep)
     = center:function  upright_l:part+ref  deep:word
  80 | joint upright_tenons   : mortise_tenon([upright_l, upright_r], into: [foot_l, foot_r], length: 35mm)
     = joint:keyword  upright_tenons:joint+decl  mortise_tenon:type+ref+std  upright_l:part+ref  upright_r:part+ref  into:field  foot_l:part+ref  foot_r:part+ref  length:param+ref+std  35:number  mm:unit
  81 | joint stretcher_tenons : mortise_tenon(stretcher, into: [upright_l, upright_r], length: 32mm, shoulder: 35mm)
     = joint:keyword  stretcher_tenons:joint+decl  mortise_tenon:type+ref+std  stretcher:part+ref  into:field  upright_l:part+ref  upright_r:part+ref  length:param+ref+std  32:number  mm:unit  shoulder:param+ref+std  35:number  mm:unit
