     = joint:keyword  beam_tenons:joint+decl  mortise_tenon:type+ref+std  top_beam:part+ref  bottom_beam:part+ref  into:field  stile_l:part+ref  stile_r:part+ref  length:param+ref+std  32:number  mm:unit  shoulder:param+ref+std  20:number  mm:unit
