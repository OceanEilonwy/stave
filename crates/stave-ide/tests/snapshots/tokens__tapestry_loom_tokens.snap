  92 |   param projection = 30mm
     = param:keyword  projection:param+decl  30:number  mm:unit
  94 |   param bolt_diameter = 8mm
     = param:keyword  bolt_diameter:param+decl  8:number  mm:unit
  96 |   param thread_length = 25mm
