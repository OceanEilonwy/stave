     = cut:keyword  bolt_hole:plain  row:function  crossing:function  piece:role+ref  bolt:member+ref  pitch:field  hole_pitch:param+ref  down:field  holes_below:param+ref  drill:function  diameter:field  bolt_diameter:param+ref  1:number  mm:unit  depth:field  through:word  wall:field  wall:param+ref
 141 |   cut insert_hole: crossing(into, bolt) { drill(diameter: bolt_diameter + 4mm, depth: thread_length, wall: wall) }
     = cut:keyword  insert_hole:plain  crossing:function  into:role+ref  bolt:member+ref  drill:function  diameter:field  bolt_diameter:param+ref  4:number  mm:unit  depth:field  thread_length:param+ref  wall:field  wall:param+ref
