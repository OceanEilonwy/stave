     = joint:keyword  tension_slides:joint+decl  sliding_tenon:type+ref  tension_bar:part+ref  into:field  stile_l:part+ref  stile_r:part+ref  travel:param+ref  tension_gap:param+ref  cap:param+ref  cap:param+ref  glue:field  false:keyword
 324 |   hardware pivot_l : pivot_bolt(stand_l, into: stile_l, face: left, washer_thickness: washer)
     = hardware:keyword  pivot_l:hardware+decl  pivot_bolt:type+ref  stand_l:param+ref  into:role+ref  stile_l:part+ref  face:field  left:word  washer_thickness:param+ref  washer:param+ref
