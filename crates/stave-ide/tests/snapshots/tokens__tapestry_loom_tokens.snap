     = slot:keyword  bolt:plain  piece:plain  from:keyword  point:function  along:field  0:number  mm:unit  across:field  0:number  mm:unit  to:keyword  point:function  along:field  holes_below:param+ref  hole_pitch:param+ref  across:field  0:number  mm:unit
