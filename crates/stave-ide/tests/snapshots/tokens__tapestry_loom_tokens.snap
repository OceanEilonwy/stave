---
source: crates/stave-ide/tests/tokens.rs
expression: "render_project(& examples().join(\"tapestry_loom\"))"
---
== loom.stave ==
   1 | stave 1
     = stave:keyword  1:number
  11 | project "Tapestry Loom" {
     = project:keyword  ":text  Tapestry Loom:text  ":text
  12 |   goal:  "A floor-standing tapestry loom whose frame tilts, turns all the way round and is set at one of four heights"
     = goal:field  ":text  A floor-standing tapestry loom whose frame tilts, turns all the way round and is set at one of four heights:text  ":text
  13 |   units: mm
     = units:field  mm:word
  21 | param overall_width    = 1150mm
     = param:keyword  overall_width:param+decl  1150:number  mm:unit
  22 | param overall_height   = 1650mm
     = param:keyword  overall_height:param+decl  1650:number  mm:unit
  23 | param overall_depth    = 700mm
     = param:keyword  overall_depth:param+decl  700:number  mm:unit
  24 | param frame_lift       = 400mm within 400mm..500mm    // floor to the bottom of the frame, at its highest
     = param:keyword  frame_lift:param+decl  400:number  mm:unit  within:keyword  400:number  mm:unit  500:number  mm:unit
  25 | param frame_height     = 1250mm within 1100mm..1250mm
     = param:keyword  frame_height:param+decl  1250:number  mm:unit  within:keyword  1100:number  mm:unit  1250:number  mm:unit
  26 | param warp_tension_gap = 40mm within 10mm..80mm
     = param:keyword  warp_tension_gap:param+decl  40:number  mm:unit  within:keyword  10:number  mm:unit  80:number  mm:unit
  27 | param washer           = 3mm within 2mm..6mm          // the gap between the stand and the frame
     = param:keyword  washer:param+decl  3:number  mm:unit  within:keyword  2:number  mm:unit  6:number  mm:unit
  28 | param tension_cap      = 40mm within 30mm..60mm
     = param:keyword  tension_cap:param+decl  40:number  mm:unit  within:keyword  30:number  mm:unit  60:number  mm:unit
  29 | let foot_height = 90mm
     = let:keyword  foot_height:let+decl  90:number  mm:unit
  31 | region envelope = box(across: overall_width, up: overall_height, deep: overall_depth)
     = region:keyword  envelope:region+decl  box:function  across:field  overall_width:param+ref  up:field  overall_height:param+ref  deep:field  overall_depth:param+ref
  34 | stock beech_45       { species: beech, form: solid, thickness: 45mm, max_width: 200mm, max_length: 2400mm }
     = stock:keyword  beech_45:stock+decl  species:field  beech:word  form:field  solid:word  thickness:field  45:number  mm:unit  max_width:field  200:number  mm:unit  max_length:field  2400:number  mm:unit
  35 | stock beech_25       { species: beech, form: solid, thickness: 25mm, max_width: 200mm, max_length: 2400mm }
     = stock:keyword  beech_25:stock+decl  species:field  beech:word  form:field  solid:word  thickness:field  25:number  mm:unit  max_width:field  200:number  mm:unit  max_length:field  2400:number  mm:unit
  36 | stock beech_dowel_25 { species: beech, form: dowel, diameter: 25mm }
     = stock:keyword  beech_dowel_25:stock+decl  species:field  beech:word  form:field  dowel:word  diameter:field  25:number  mm:unit
  39 | part foot_l : beech_45 {
     = part:keyword  foot_l:part+decl  beech_45:stock+ref
  40 |   length: overall_depth
     = length:field  overall_depth:param+ref
  41 |   width:  foot_height
     = width:field  foot_height:let+ref
  42 |   note:   "Shape the underside with a relief so the foot stands on its two ends"
     = note:field  ":text  Shape the underside with a relief so the foot stands on its two ends:text  ":text
  43 |   place {
     = place:keyword
  44 |     orient(length: back, width: up)
     = orient:function  length:field  back:word  width:field  up:word
  45 |     flush(envelope.bottom)
     = flush:function  envelope:region+ref  bottom:plain
  46 |     flush(envelope.left)
     = flush:function  envelope:region+ref  left:plain
  47 |     center(envelope, deep)
     = center:function  envelope:region+ref  deep:word
  51 | part foot_r = mirror(foot_l, about: mid(envelope, across))
     = part:keyword  foot_r:part+decl  mirror:keyword  foot_l:part+ref  about:field  mid:function  envelope:region+ref  across:word
  53 | part upright_l : beech_45 {
     = part:keyword  upright_l:part+decl  beech_45:stock+ref
  54 |   length: 1100mm
     = length:field  1100:number  mm:unit
  55 |   width:  70mm
     = width:field  70:number  mm:unit
  56 |   note:   "Drill the row of height holes after the stand is glued up"
     = note:field  ":text  Drill the row of height holes after the stand is glued up:text  ":text
  57 |   place {
     = place:keyword
  58 |     orient(length: up, width: back)
     = orient:function  length:field  up:word  width:field  back:word
  59 |     against(foot_l.top)
     = against:function  foot_l:part+ref  top:plain
  60 |     flush(foot_l.left)
     = flush:function  foot_l:part+ref  left:plain
  61 |     center(foot_l, deep)
     = center:function  foot_l:part+ref  deep:word
  65 | part upright_r = mirror(upright_l, about: mid(envelope, across))
     = part:keyword  upright_r:part+decl  mirror:keyword  upright_l:part+ref  about:field  mid:function  envelope:region+ref  across:word
  69 | part stretcher : beech_25 {
     = part:keyword  stretcher:part+decl  beech_25:stock+ref
  70 |   length: fit
     = length:field  fit:keyword
  71 |   width:  150mm
     = width:field  150:number  mm:unit
  72 |   place {
     = place:keyword
  73 |     orient(length: right, width: up)
     = orient:function  length:field  right:word  width:field  up:word
  74 |     flush(upright_l.bottom)
