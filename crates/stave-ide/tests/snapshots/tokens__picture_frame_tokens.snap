---
source: crates/stave-ide/tests/tokens.rs
assertion_line: 378
expression: "render_project(& examples().join(\"picture_frame\"))"
---
== frame.stave ==
   1 | stave 1
     = stave:keyword  1:number
  19 | project "Picture frame" {
     = project:keyword  ":text  Picture frame:text  ":text
  20 |   goal:       "A mitred oak picture frame and a mitred box to match"
     = goal:field  ":text  A mitred oak picture frame and a mitred box to match:text  ":text
  21 |   units:      mm
     = units:field  mm:word
  22 |   resolution: 0.5mm
     = resolution:field  0.5:number  mm:unit
  23 |   tools:      [pencil, marking_knife, square, tape, sliding_bevel, tenon_saw,
     = tools:field  pencil:type+ref+std  marking_knife:type+ref+std  square:type+ref+std  tape:type+ref+std  sliding_bevel:type+ref+std  tenon_saw:type+ref+std
  24 |                block_plane, mitre_saw, router, chamfer_bit, roundover_bit, clamps]
     = block_plane:type+ref+std  mitre_saw:type+ref+std  router:type+ref+std  chamfer_bit:type+ref+std  roundover_bit:type+ref+std  clamps:type+ref+std
  28 | param frame_width  = 400mm within 200mm..800mm     // outside, left to right
     = param:keyword  frame_width:param+decl  400:number  mm:unit  within:keyword  200:number  mm:unit  800:number  mm:unit
  29 | param frame_height = 300mm within 150mm..600mm     // outside, front to back as it lies
     = param:keyword  frame_height:param+decl  300:number  mm:unit  within:keyword  150:number  mm:unit  600:number  mm:unit
  30 | param moulding     = 40mm within 25mm..70mm        // how wide each member is
     = param:keyword  moulding:param+decl  40:number  mm:unit  within:keyword  25:number  mm:unit  70:number  mm:unit
  31 | param box_length   = 240mm within 150mm..400mm
     = param:keyword  box_length:param+decl  240:number  mm:unit  within:keyword  150:number  mm:unit  400:number  mm:unit
  32 | param box_depth    = 160mm within 100mm..300mm
     = param:keyword  box_depth:param+decl  160:number  mm:unit  within:keyword  100:number  mm:unit  300:number  mm:unit
  33 | param box_height   = 90mm within 50mm..200mm
     = param:keyword  box_height:param+decl  90:number  mm:unit  within:keyword  50:number  mm:unit  200:number  mm:unit
  36 | stock oak_19 { species: white_oak, form: solid, thickness: 19mm, max_width: 200mm, max_length: 2400mm }
     = stock:keyword  oak_19:stock+decl  species:field  white_oak:word  form:field  solid:word  thickness:field  19:number  mm:unit  max_width:field  200:number  mm:unit  max_length:field  2400:number  mm:unit
  37 | stock oak_12 { species: white_oak, form: solid, thickness: 12mm, max_width: 200mm, max_length: 2400mm }
     = stock:keyword  oak_12:stock+decl  species:field  white_oak:word  form:field  solid:word  thickness:field  12:number  mm:unit  max_width:field  200:number  mm:unit  max_length:field  2400:number  mm:unit
  38 | stock ply_12 { species: birch, form: plywood, thickness: 12mm, max_width: 1220mm, max_length: 2440mm }
     = stock:keyword  ply_12:stock+decl  species:field  birch:word  form:field  plywood:word  thickness:field  12:number  mm:unit  max_width:field  1220:number  mm:unit  max_length:field  2440:number  mm:unit
