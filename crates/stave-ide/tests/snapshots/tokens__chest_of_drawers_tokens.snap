---
source: crates/stave-ide/tests/tokens.rs
expression: "render_project(& examples().join(\"chest_of_drawers\"))"
---
== chest.stave ==
   1 | stave 1
     = stave:keyword  1:number
   3 | import "std:casework"
     = import:keyword  ":text  std:casework:text  ":text
  11 | project "Chest of drawers" {
     = project:keyword  ":text  Chest of drawers:text  ":text
  12 |   goal:       "A chest of four graduated drawers on bun feet"
     = goal:field  ":text  A chest of four graduated drawers on bun feet:text  ":text
  13 |   units:      mm
     = units:field  mm:word
  14 |   resolution: 0.5mm        // the cut list rounds to this and says where it rounded
     = resolution:field  0.5:number  mm:unit
  15 |   tools:      [pencil, marking_knife, square, tape, marking_gauge, awl, calipers,
     = tools:field  pencil:type+ref+std  marking_knife:type+ref+std  square:type+ref+std  tape:type+ref+std  marking_gauge:type+ref+std  awl:type+ref+std  calipers:type+ref+std
  16 |                tenon_saw, chisel, mallet, router_plane, clamps, screwdriver,
     = tenon_saw:type+ref+std  chisel:type+ref+std  mallet:type+ref+std  router_plane:type+ref+std  clamps:type+ref+std  screwdriver:type+ref+std
  17 |                router, straight_bit, drill, depth_stop,
     = router:type+ref+std  straight_bit:type+ref+std  drill:type+ref+std  depth_stop:type+ref+std
  18 |                lathe, roughing_gouge, spindle_gouge, parting_tool]
     = lathe:type+ref+std  roughing_gouge:type+ref+std  spindle_gouge:type+ref+std  parting_tool:type+ref+std
  21 | param overall_width  = 800mm
     = param:keyword  overall_width:param+decl  800:number  mm:unit
  22 | param overall_height = 1000mm
     = param:keyword  overall_height:param+decl  1000:number  mm:unit
  23 | param overall_depth  = 480mm
     = param:keyword  overall_depth:param+decl  480:number  mm:unit
  25 | region envelope = box(across: overall_width, up: overall_height, deep: overall_depth)
     = region:keyword  envelope:region+decl  box:function  across:field  overall_width:param+ref  up:field  overall_height:param+ref  deep:field  overall_depth:param+ref
  28 | stock oak_19    { species: white_oak, form: solid, thickness: 19mm, max_width: 200mm, max_length: 2700mm }
     = stock:keyword  oak_19:stock+decl  species:field  white_oak:word  form:field  solid:word  thickness:field  19:number  mm:unit  max_width:field  200:number  mm:unit  max_length:field  2700:number  mm:unit
  29 | stock maple_12  { species: hard_maple, form: solid, thickness: 12mm, max_width: 150mm, max_length: 2400mm }
     = stock:keyword  maple_12:stock+decl  species:field  hard_maple:word  form:field  solid:word  thickness:field  12:number  mm:unit  max_width:field  150:number  mm:unit  max_length:field  2400:number  mm:unit
  30 | stock ply_6     { species: birch, form: plywood, thickness: 6mm, max_width: 1220mm, max_length: 2440mm }
     = stock:keyword  ply_6:stock+decl  species:field  birch:word  form:field  plywood:word  thickness:field  6:number  mm:unit  max_width:field  1220:number  mm:unit  max_length:field  2440:number  mm:unit
  31 | stock oak_75_sq { species: white_oak, form: solid, thickness: 75mm, width: 75mm, max_length: 2700mm }
     = stock:keyword  oak_75_sq:stock+decl  species:field  white_oak:word  form:field  solid:word  thickness:field  75:number  mm:unit  width:field  75:number  mm:unit  max_length:field  2700:number  mm:unit
  33 | assembly case : casework.Case {
     = assembly:keyword  case:assembly+decl  casework:module+ref+std  Case:type+ref+std
  34 |   space:       envelope
     = space:param+ref+std  envelope:region+ref
  35 |   panel_stock: oak_19
     = panel_stock:param+ref+std  oak_19:stock+ref
  36 |   raise:       80mm
     = raise:param+ref+std  80:number  mm:unit
  39 | assembly back : casework.Back {
     = assembly:keyword  back:assembly+decl  casework:module+ref+std  Back:type+ref+std
  40 |   sides:       case.side[*]
     = sides:param+ref+std  case:assembly+ref  side:part+ref+std
  41 |   stands_on:   case.base
     = stands_on:param+ref+std  case:assembly+ref  base:part+ref+std
  42 |   under:       case.top
     = under:param+ref+std  case:assembly+ref  top:part+ref+std
  43 |   panel_stock: ply_6
     = panel_stock:param+ref+std  ply_6:stock+ref
  46 | region drawer_bay[4] = split(back.in_front, up, shares: [5, 4, 3, 2])
     = region:keyword  drawer_bay:region+decl  4:number  split:function  back:assembly+ref  in_front:region+ref+std  up:word  shares:field  5:number  4:number  3:number  2:number
  48 | assembly drawer[4] : casework.Drawer {
     = assembly:keyword  drawer:assembly+decl  4:number  casework:module+ref+std  Drawer:type+ref+std
  49 |   opening:      drawer_bay[same]
     = opening:param+ref+std  drawer_bay:region+ref  same:keyword
  50 |   mount:        overlay(left: 18mm, right: 18mm, top: -3mm, bottom: 8mm, meeting: -2.5mm)
     = mount:param+ref+std  overlay:function  left:field  18:number  mm:unit  right:field  18:number  mm:unit  top:field  3:number  mm:unit  bottom:field  8:number  mm:unit  meeting:field  2.5:number  mm:unit
  51 |   front_stock:  oak_19
     = front_stock:param+ref+std  oak_19:stock+ref
  52 |   box_stock:    maple_12
     = box_stock:param+ref+std  maple_12:stock+ref
  53 |   bottom_stock: ply_6
     = bottom_stock:param+ref+std  ply_6:stock+ref
  54 |   slide:        side_mount_slide(length: 400mm)
     = slide:param+ref+std  side_mount_slide:type+ref+std  length:param+ref+std  400:number  mm:unit
  57 | assembly feet : casework.Feet {
     = assembly:keyword  feet:assembly+decl  casework:module+ref+std  Feet:type+ref+std
  58 |   under:      case.base
     = under:param+ref+std  case:assembly+ref  base:part+ref+std
  59 |   foot_stock: oak_75_sq
     = foot_stock:param+ref+std  oak_75_sq:stock+ref
