stave 1

// A bookcase with two adjustable shelves: two sides, a top and a bottom in
// dados, a plywood back in rabbets, and two shelves that rest on shelf pins.
//
// Each shelf lifts out and moves to another pair of holes: every side is
// drilled with a row of spare holes above and below the pins, 32mm apart.
// The shelves are not glued or joined to anything; their pins hold them.

import "std:casework"

project "Adjustable bookcase" {
  goal:       "A pine bookcase whose two shelves move up and down on shelf pins"
  units:      mm
  resolution: 0.5mm
  tools:      [pencil, square, tape, marking_gauge, router, straight_bit, clamps,
               drill, depth_stop, awl]
}

// ---- parameters ----
param case_height = 1100mm within 900mm..1500mm
param case_width  = 700mm within 500mm..800mm      // longer shelves sag under books
param case_depth  = 280mm within 240mm..350mm
let dado_depth = 9mm

// ---- stock ----
stock pine_19 { species: pine, form: solid, thickness: 19mm, max_width: 300mm, max_length: 2400mm }
stock ply_6   { species: birch, form: plywood, thickness: 6mm, max_width: 1220mm, max_length: 2440mm }

// ---- the case ----

/// The left side stands on the floor; everything else is placed from it.
part side_l : pine_19 {
  length: case_height
  width:  case_depth
  place {
    ground
    orient(length: up, width: back)
  }
}

/// The right side: the same board, the inside width away from the left one.
part side_r : pine_19 {
  length: case_height
  width:  case_depth
  place {
    orient(length: up, width: back)
    against(side_l.right, gap: case_width - 2 * pine_19.thickness)
    flush(side_l.bottom)
    flush(side_l.front)
  }
}

/// The top, housed in a dado near the top of each side.
part top : pine_19 {
  length: fit
  width:  case_depth - back.thickness
  place {
    flush(side_l.top, inset: 20mm)
    center(from: side_l.right, to: side_r.left)
    flush(side_l.front)
  }
}

/// The bottom, housed in a dado a kick's height above the floor.
part bottom : pine_19 {
  length: fit
  width:  case_depth - back.thickness
  place {
    flush(side_l.bottom, inset: 60mm)
    center(from: side_l.right, to: side_r.left)
    flush(side_l.front)
  }
}

/// The back keeps the case square, housed in a rabbet in each side.
part back : ply_6 {
  length: between(bottom.bottom, top.top)
  width:  fit
  place {
    orient(length: up, width: right)
    flush(top.top)
    center(from: side_l.right, to: side_r.left)
    flush(side_l.back)
  }
}

// ---- joints ----
joint case_dados   : dado([top, bottom], into: [side_l, side_r], depth: dado_depth)
joint back_rabbets : rabbet(back, into: [side_l, side_r], depth: dado_depth)

// ---- the shelves ----

/// The space between the sides, the bottom, the top and the back.
region inside = opening(
  left:   side_l.right,
  right:  side_r.left,
  bottom: bottom.top,
  top:    top.bottom,
  front:  side_l.front,
  back:   back.front,
)

/// The lower shelf, a third of the way up.
assembly lower_shelf : casework.AdjustableShelf {
  space:       inside
  left_side:   side_l
  right_side:  side_r
  panel_stock: pine_19
  height:      300mm
}

/// The upper shelf, two thirds of the way up, with a row of spare holes
/// of its own.
assembly upper_shelf : casework.AdjustableShelf {
  space:       inside
  left_side:   side_l
  right_side:  side_r
  panel_stock: pine_19
  height:      620mm
}
