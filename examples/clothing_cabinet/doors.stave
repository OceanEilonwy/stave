stave 1

import "./casework"
import "./hardware" as hw          // 'hardware' is a reserved word, so the module needs another name

// Two frame-and-panel doors on cup hinges. door_r is the mirror image of
// door_l: the finished door is reflected, so it hinges on side_r.

assembly door_l : casework.FramePanelDoor {
  opening:     door_bay[left]
  hinge_side:  side_l
  mount:       overlay(left: 18mm, right: 18mm, top: -reveal, bottom: 8mm, meeting: -reveal / 2)
  frame:       oak_19
  panel_stock: oak_6
  knob_kind:   hw.brass_knob_26
}

assembly door_r = mirror(door_l, about: mid(base, across))
