stave 1

/// A frame-and-panel door: two stiles, two rails and a floating panel.
component FramePanelDoor {
  param opening     : Region
  param hinge_side  : Part               // the cabinet side the hinges screw to
  param mount       : Mount
  param frame       : Stock
  param panel_stock : Stock
  param stile_width = 60mm
  param rail_width  = 60mm
  param joinery     : JointKind = cope_and_stick
  param hinge_kind  : HingeKind = euro_hinge(opening_angle: 110deg)
  param knob_kind   : PullKind = knob(diameter: 26mm)

  require stile_holds_cup : stile_width >= hinge_kind.cup_diameter + 2 * hinge_kind.cup_inset "the stile is too narrow for the hinge cup"

  /// The space the closed door fills, in front of its opening.
  region door = cover(opening, mount, thickness: frame.thickness)

  part stile[hinge, latch] : frame {
    length: door.up
    width:  stile_width
    place {
      orient(length: up, width: right)
      spaced(ends, from: door.left, to: door.right)
      flush(door.bottom)
      flush(door.front)
    }
  }

  part rail[bottom, top] : frame {
    length: fit                          // between the stiles; the stub tenons are added by the joint
    width:  rail_width
    place {
      orient(length: right, width: up)
      spaced(ends, from: door.bottom, to: door.top)
      center(door, across)
      flush(door.front)
    }
  }

  part panel : panel_stock {
    length: fit                          // between the rails, plus what sits in the grooves
    width:  fit                          // between the stiles, plus what sits in the grooves
    place {
      orient(length: up, width: right)
      center(door, up)
      center(door, across)
      center(door, deep)
    }
  }

  joint frame_joints : joinery(rail[*], into: stile[*])
  // A solid panel must float: no glue, and room in the grooves to swell.
  joint panel_groove : groove(panel, into: [stile[*], rail[*]], depth: 10mm, clearance: 2mm, glue: false)

  hardware hinges[lower, upper] : hinge_kind(stile[hinge], on: hinge_side) {
    place {
      spaced(ends(inset: 100mm), from: door.bottom, to: door.top)
    }
  }

  hardware handle : knob_kind(stile[latch]) {
    place {
      center(stile[latch], across)
      center(stile[latch], up)
    }
  }
}
