stave 1

import "./casework"
import "./hardware"

// Two drawers on side-mount slides, one per bay. The box width follows the
// opening, so a wider cabinet gives wider drawers.

assembly drawer[bottom, top] : casework.Drawer {
  opening:      drawer_bay[*]            // each drawer gets its own bay
  mount:        overlay(left: 18mm, right: 18mm, top: 8mm, bottom: 8mm, meeting: -reveal / 2)
  front_stock:  oak_19
  box_stock:    maple_12
  bottom_stock: ply_6
  slide:        side_mount_slide(length: slide_length)
  pull_kind:    hardware.bar_pull_160
}
