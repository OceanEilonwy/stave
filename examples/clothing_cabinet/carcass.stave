stave 1

// The box: base, sides, top, back, divider, shelf, rod, feet, and the
// openings that the doors and drawers fill.

part base : oak_19 {
  length: cabinet_width
  width:  cabinet_depth          // wider than oak_19's max_width: made of boards, glued edge to edge
  place {
    ground
  }
}

part side_l : oak_19 {
  length: cabinet_height - base.thickness - top.thickness
  width:  cabinet_depth
  place {
    orient(length: up, width: back)
    against(base.top)            // stands on the base
    flush(base.left)
    flush(base.back)
  }
}

part side_r = mirror(side_l, about: mid(base, across))

part top : oak_19 {
  length: cabinet_width + 2 * overhang
  width:  cabinet_depth + overhang
  place {
    against(side_l.top)          // sits on the sides
    center(base, across)
    flush(base.back)             // so it overhangs the front and both ends
  }
}

/// Stands on the base behind the divider and shelf, housed in a rabbet in each side.
part back : ply_6 {
  length: between(base, top)
  width:  fit                    // between the sides; the rabbet depth is added by the joint
  place {
    orient(length: up, width: right)
    against(base.top)
    center(base, across)
    flush(base.back)
  }
}

/// Separates the hanging space from the drawers.
part divider : oak_19 {
  length: fit                    // between the sides; the dado depth is added by the joint
  width:  cabinet_depth - back.thickness
  place {
    against(base.top, gap: drawer_zone)
    center(base, across)
    flush(side_l.front)
  }
}

part shelf : oak_19 {
  length: fit
  width:  cabinet_depth - back.thickness
  place {
    against(top.bottom, gap: 160mm)
    center(base, across)
    flush(side_l.front)
  }
}

part rod : oak_dowel_28 {
  length: fit                    // between the sides; the socket depth is added by the joint
  place {
    against(shelf.bottom, gap: 50mm)
    center(base, across)
    center(from: side_l.front, to: back.front)
  }
}

part foot[front_left, front_right, back_left, back_right] : oak_75_sq {
  length: fit                    // from the profile; the tenon is added by the joint
  shape:  turned(bun_foot)
  place {
    orient(length: down)         // station 0 of the profile is at the top, against the base
    corners(base, inset: 60mm)
    against(base.bottom)
  }
}

/// The foot you see. Its round tenon is not drawn here: the joint adds it.
profile bun_foot {
  measure: diameter
  smooth:  true
  at 0mm:  70mm
  at 34mm: 70mm
  at 80mm: 40mm
}

// ---- joints ----
joint shelf_dados  : dado([divider, shelf], into: [side_l, side_r], depth: 9mm)
joint back_rabbets : rabbet(back, into: [side_l, side_r], depth: 9mm)
joint base_dowels  : dowel([side_l, side_r], into: base, count: 4)
joint top_dowels   : dowel([side_l, side_r], into: top, count: 4)
joint rod_sockets  : socket(rod, into: [side_l, side_r], depth: 9mm)
joint foot_tenons  : round_tenon(foot[*], into: base, diameter: 19mm, length: 16mm)

// ---- openings ----
region front_opening = opening(
  left:   side_l.right,
  right:  side_r.left,
  bottom: base.top,
  top:    top.bottom,
  front:  side_l.front,
  back:   back.front,
)
region bay[drawers, doors]     = split(front_opening, up, at: divider)
region drawer_bay[bottom, top] = split(bay[drawers], up)
region door_bay[left, right]   = split(bay[doors], across)
