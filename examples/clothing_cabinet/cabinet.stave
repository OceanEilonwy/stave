stave 1

// The project module: every .stave file in this folder shares these names.
// carcass.stave, doors.stave and drawers.stave use them without importing.

project "Clothing cabinet" {
  goal:       "Heirloom quality clothing cabinet with two hinged doors and two drawers at the bottom"
  units:      mm
  resolution: 0.5mm        // the cut list rounds to this and says where it rounded
  style:      "shaker"     // a hint for suggestions
  // Work cards use the recipes these tools allow.
  tools:      [pencil, marking_knife, square, tape, marking_gauge, awl, calipers,
               tenon_saw, chisel, mallet, router_plane, clamps, screwdriver,
               router, straight_bit, drill, depth_stop,
               lathe, roughing_gouge, spindle_gouge, parting_tool]
}

// ---- parameters: the knobs ----
// Every check must hold for every value inside these ranges.
       param cabinet_width  = 900mm within 600mm..1200mm
       param cabinet_height = 1700mm within 1400mm..2100mm    // bottom of the base to top of the top, without feet
       param cabinet_depth  = 560mm within 550mm..650mm
       param drawer_zone    = 500mm within 300mm..600mm       // height of the drawer section
       param slide_length   = 500mm within [350mm, 400mm, 450mm, 500mm]
locked param reveal         = 1.5mm                           // gap between neighbouring fronts
locked param drawer_reveal  = 5mm                             // gap between the drawer fronts: oak fronts this tall close up over 3mm with the seasons

let overhang = 20mm

// ---- checks that must stay true ----
require hanger_room    : cabinet_depth - back.thickness >= 540mm "room for coat hangers"
require overall_height : extent([base, side_l, top], up) == cabinet_height "overall height matches cabinet_height"

// ---- scenes ----
scene all_open "All open" {
  pose door_l = open
  pose door_r = open
  pose drawer[top] = open
}

scene drawer_bench "Top drawer on the bench" {
  show:    drawer[top]
  explode: true
}
