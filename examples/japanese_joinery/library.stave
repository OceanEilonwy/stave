stave 1

// Two Japanese joints, written to prove that joint kinds are pluggable:
// nothing here needs code in Stave itself.
//
//   ari_tsugi     simple: one cut per beam, one assembly step
//   chidori       complex: three named roles in one node and a quarter turn to lock
//
// The third sample, kanawa_tsugi (marked-out outlines, a key the joint
// makes, two steps), was promoted to std:joinery as a splice for long
// parts (grammar, "Splices"); the samples project uses it from there.
// ari_tsugi works as a splice too: lengths: spliced(by: japanese.ari_tsugi, ...).
//
// These are samples for the format. Check a joinery reference (and make a
// trial piece) before cutting good timber from them.

library "Japanese joinery samples" {
  about: "Sample joint kinds: ari tsugi and chidori"
}

/// An ink line: snaps a long, straight line along a beam.
kind sumitsubo : tool {
  title: "sumitsubo (ink line)"
}

/// A marked-out shape laid out with an ink line and sawn by hand. A library
/// can add its own way of marking: `with:` names the tool on any step.
recipe outline_with_sumitsubo : outline {
  tools: [sumitsubo, square, marking_knife, tenon_saw, chisel, mallet]
  rank:  5
  mark {
    line(outline, with: sumitsubo)
    square_around(outline)
    hatch(waste)
  }
  cut {
    saw(outline)
    chop(waste)
    pare(outline)
  }
  check: "the cut faces are flat and split the ink lines"
}
