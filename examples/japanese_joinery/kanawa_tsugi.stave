stave 1

/// Kanawa tsugi: a stepped scarf splice that joins two beams end to end,
/// locked by a key driven across the middle of the joint.
///
/// Simplified: the small tip tenons (hozo) of the traditional joint are left
/// out. The proportions are common starting points, not a tested pattern.
kind kanawa_tsugi : joint {
  roles {
    piece: Part
    into:  Part
  }
  /// Overall length of the splice.
  param scarf = 3 * piece.width
  /// Height left at each tip.
  param tip = piece.width / 5
  /// Height of the step in the middle.
  param step = piece.width / 5
  /// Thickness of the key.
  param key_thickness = piece.thickness / 4
  /// What the key is made from.
  param key_stock : Stock = into.stock
  require same_section : piece.width == into.width && piece.thickness == into.thickness "both beams need the same section"
  require room : scarf <= piece.length / 3 && scarf <= into.length / 3 "the splice is too long for these beams"

  // The beams are drawn meeting end to end; each reaches half the splice past that point.
  adds: [extend(piece, by: scarf / 2), extend(into, by: scarf / 2)]

  // Seen from the side, everything above the stepped line is cut away.
  cut side(piece, normal: thickness, from: into) {
    outline(depth: through, marks: [
      mark(along: 0mm,       across: tip),
      mark(along: scarf / 2, across: (piece.width - step) / 2),
      mark(along: scarf / 2, across: (piece.width + step) / 2),
      mark(along: scarf,     across: piece.width),
      mark(along: 0mm,       across: piece.width),
    ])
  }

  // The other beam gets the same shape turned over, with its step moved by the
  // key's thickness, which leaves the slot the key is driven through.
  cut side(into, normal: thickness, from: piece, flip: true) {
    outline(depth: through, marks: [
      mark(along: 0mm,                       across: tip),
      mark(along: scarf / 2 + key_thickness, across: (into.width - step) / 2),
      mark(along: scarf / 2 + key_thickness, across: (into.width + step) / 2),
      mark(along: scarf,                     across: into.width),
      mark(along: 0mm,                       across: into.width),
    ])
  }

  /// The joint makes its own key. It appears in the cut list and the build manual.
  makes part key : key_stock {
    length:    piece.thickness + 2 * 10mm     // stands 10mm proud on each face
    width:     step
    thickness: key_thickness                  // planed down from key_stock
    place {
      orient(length: thickness, width: width, of: piece)   // lies across the beams
      center(crossing(piece, into))                        // in the middle of the splice
    }
  }

  cut_first: [into, piece]                    // cut into first, then fit piece to it; the key comes last

  insert: [
    push(piece, along: thickness),            // bring the beams together from the side
    drive(key, along: length),                // knock the key through to pull the joint tight
  ]

  note: "Mark both beams from the same story stick; plane the key to {key_thickness} and drive it through the slot"
}
