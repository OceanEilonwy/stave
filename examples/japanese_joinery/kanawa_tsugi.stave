stave 1

/// Kanawa tsugi: a stepped scarf splice that joins two beams end to end.
///
/// The two halves are the same shape, one turned over. Each has a long sloping
/// face with a step in the middle, and a small stub tenon at its tip that fits
/// a hidden recess in the other half. Because the stubs are hidden, one half is
/// laid down one stub length short of its place and slid along the beam until
/// the stubs engage. A square draw pin (komisen) driven through the gap left at
/// the step locks the joint.
///
/// Proportions follow common practice: the splice about three times the beam's
/// height, the stubs about an eighth of it. Make a trial joint first.
kind kanawa_tsugi : joint {
  roles {
    piece: Part
    into:  Part
  }
  /// Length of the sloping faces, about three times the beam's height.
  param scarf = 3 * piece.width
  /// Height left at each tip.
  param tip = piece.width / 5
  /// Height of the step in the middle.
  param step = piece.width / 5
  /// Length of each stub tenon, and how far the halves slide to engage them.
  param stub = piece.width / 8
  /// Gap left at the step for the pin.
  param pin_size = piece.thickness / 4
  /// What the pin is made from: a hardwood.
  param pin_stock : Stock = into.stock

  require same_section : piece.width == into.width && piece.thickness == into.thickness "both beams need the same section"
  require room         : scarf + stub <= piece.length / 3 && scarf + stub <= into.length / 3 "the splice is too long for these beams"

  // The beams are drawn meeting end to end; each reaches half the splice, plus
  // its stub, past that point.
  adds: [extend(piece, by: scarf / 2 + stub), extend(into, by: scarf / 2 + stub)]

  // Seen from the side, everything above the stepped line is cut away. The
  // line climbs from the tip's height at the stub to the full height less
  // the tip at the root, so turned end for end it is the line the other half
  // keeps below. The first stub length at the tip is the stub tenon (shaped
  // below); the last tip of height at the root is the hidden recess's mouth.
  cut scarf: side(piece, normal: thickness, from: into) {
    outline(depth: through, marks: [
      mark(along: stub, across: tip),
      mark(along: stub + scarf / 2 + pin_size / 2, across: (piece.width - step) / 2),
      mark(along: stub + scarf / 2 + pin_size / 2, across: (piece.width + step) / 2),
      mark(along: stub + scarf, across: piece.width - tip),
      mark(along: stub + scarf, across: piece.width),
      mark(along: 0mm, across: piece.width),
      mark(along: 0mm, across: tip),
    ])
    // Shape the stub: cut its outer third away from this face...
    outline(depth: piece.thickness / 3, marks: [
      mark(along: 0mm, across: 0mm),
      mark(along: stub, across: 0mm),
      mark(along: stub, across: tip),
      mark(along: 0mm, across: tip),
    ])
    // ...and cut the hidden recess for the other half's stub, at the root.
    outline(from_depth: piece.thickness / 3, depth: 2 * piece.thickness / 3, marks: [
      mark(along: stub + scarf, across: piece.width - tip),
      mark(along: 2 * stub + scarf, across: piece.width - tip),
      mark(along: 2 * stub + scarf, across: piece.width),
      mark(along: stub + scarf, across: piece.width),
    ])
  }
  // The stub's other outer third, from the opposite face.
  cut stub_cheek: side(piece, normal: thickness, from: into, opposite: true) {
    outline(depth: piece.thickness / 3, marks: [
      mark(along: 0mm, across: 0mm),
      mark(along: stub, across: 0mm),
      mark(along: stub, across: tip),
      mark(along: 0mm, across: tip),
    ])
  }

  // The other half: the same shape, turned end for end. Each step stands half
  // the pin's size past the middle of the splice, so the two steps end up a
  // pin's size apart, centred in the splice: the gap the pin is driven through.
  cut mating_scarf: side(into, normal: thickness, from: piece, flip: true) {
    outline(depth: through, marks: [
      mark(along: stub, across: tip),
      mark(along: stub + scarf / 2 + pin_size / 2, across: (into.width - step) / 2),
      mark(along: stub + scarf / 2 + pin_size / 2, across: (into.width + step) / 2),
      mark(along: stub + scarf, across: into.width - tip),
      mark(along: stub + scarf, across: into.width),
      mark(along: 0mm, across: into.width),
      mark(along: 0mm, across: tip),
    ])
    outline(depth: into.thickness / 3, marks: [
      mark(along: 0mm, across: 0mm),
      mark(along: stub, across: 0mm),
      mark(along: stub, across: tip),
      mark(along: 0mm, across: tip),
    ])
    outline(from_depth: into.thickness / 3, depth: 2 * into.thickness / 3, marks: [
      mark(along: stub + scarf, across: into.width - tip),
      mark(along: 2 * stub + scarf, across: into.width - tip),
      mark(along: 2 * stub + scarf, across: into.width),
      mark(along: stub + scarf, across: into.width),
    ])
  }
  cut mating_stub_cheek: side(into, normal: thickness, from: piece, flip: true, opposite: true) {
    outline(depth: into.thickness / 3, marks: [
      mark(along: 0mm, across: 0mm),
      mark(along: stub, across: 0mm),
      mark(along: stub, across: tip),
      mark(along: 0mm, across: tip),
    ])
  }

  /// The square draw pin (komisen). It appears in the cut list and the build manual.
  makes part pin : pin_stock {
    length:    piece.thickness + 2 * 10mm     // stands 10mm proud on each face
    width:     step
    thickness: pin_size                       // planed down from pin_stock
    place {
      orient(length: thickness, width: width, of: piece)   // lies across the beams
      center(crossing(piece, into))                        // in the gap at the step
    }
  }

  cut_first: [into, piece]                    // cut into first, then fit piece to it; the pin comes last

  insert: [
    push(piece, along: width),                // lay the beam down, one stub length short
    push(piece, along: length, by: stub),     // slide it along until the stubs engage
    drive(pin, along: length),                // drive the pin through the gap to draw the joint tight
  ]

  note: "Mark both halves from the same story stick; lay {piece} down {stub} short of its place and slide it home before driving the pin"
}
