stave 1

/// Chidori: three square sticks crossing at right angles in one node, locked
/// by giving the third stick a quarter turn.
///
/// Schematic: this exercises three named roles and a turn in the assembly
/// sequence. It is not a tested cutting pattern; make a trial node in
/// softwood before relying on these proportions.
kind chidori : joint {
  roles {
    lock:   Part                      // the stick that turns to lock the node
    first:  Part                      // the two sticks that cross first
    second: Part
  }
  /// The side of the square section all three sticks share.
  param size = lock.width
  require square : lock.width == size && lock.thickness == size &&
                   first.width == size && first.thickness == size &&
                   second.width == size && second.thickness == size "all three sticks need the same square section"

  schematic: true                     // the cuts below don't describe the whole node, so its fit isn't checked

  // The first two sticks are halved over each other.
  cut crossing(first, second) {
    notch(depth: size / 2)
  }
  cut crossing(second, first, opposite: true) {
    notch(depth: size / 2)
  }

  // Both get a slot that lets the third stick pass through edge-on.
  cut crossing(first, lock) {
    slot(width: size / 2, depth: through)
  }
  cut crossing(second, lock) {
    slot(width: size / 2, depth: through)
  }

  // The third stick is slotted where it passes, so it can turn once it's in.
  cut crossing(lock, first) {
    slot(width: size / 2, depth: size / 2)
  }

  cut_first: [first, second, lock]            // cut the crossing pair first, then fit the turning stick

  insert: [
    push(second, along: thickness),           // halve the first two sticks together
    push(lock, along: length),                // push the third stick through, edge-on
    rotate(lock, by: 90deg, about: length),   // a quarter turn locks the node
  ]

  note: "Assemble the halving, push {lock} through edge-on, then give it a quarter turn"
}
