stave 1

/// Ari tsugi: a dovetailed end joint. The tail on one beam drops into a
/// socket in the end of the other.
kind ari_tsugi : joint {
  roles {
    piece: Part                      // carries the tail
    into:  Part                      // carries the socket
  }
  /// Width of the tail where it leaves its beam.
  param neck = piece.width / 3
  /// Length of the tail.
  param depth = piece.width / 2
  /// Slope of the tail's cheeks.
  param angle = 10deg
  require same_section : piece.width == into.width && piece.thickness == into.thickness "both beams need the same section"
  require fits         : depth <= into.length / 4 "the dovetail is too deep for this beam"

  // The tail is drawn on the wide face and cut square through the thickness,
  // so the beam goes in along its thickness: from above, for a beam lying flat.
  insert:    [push(piece, along: thickness)]
  cut_first: piece                        // cut the tail first, then mark the socket from it
  adds:      extend(piece, by: depth)     // the beams are drawn meeting end to end; the tail reaches past

  cut socket: end(into, facing: piece) {
    dovetail_socket(neck: neck, depth: depth, angle: angle)
  }
  cut tail: end(piece, facing: into) {
    dovetail_tail(neck: neck, depth: depth, angle: angle)
  }

  note: "Set a sliding bevel to {angle} for the tail; trace the finished tail onto {into} to mark the socket"
}
