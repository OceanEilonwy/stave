stave 1

/// A back panel that closes the rear of a cabinet, housed in a rabbet in each side.
/// It stands on the base, reaches up to the underside of the top, and fits
/// between the sides; the rabbet depth is added by the joint.
component Back {
  param sides       : Parts          // the cabinet sides it is housed in
  param stands_on   : Part           // the base it stands on, flush with its back
  param under       : Part           // the top it reaches up to
  param panel_stock : Stock
  param joinery     : JointKind = rabbet
  param depth       = 9mm            // how far the rabbets are cut into the sides

  part panel : panel_stock {
    length: between(stands_on, under)
    width:  fit                      // between the sides; the rabbet depth is added by the joint
    place {
      orient(length: up, width: right)
      against(stands_on.top)
      center(stands_on, across)
      flush(stands_on.back)
    }
  }

  joint housing : joinery(panel, into: sides, depth: depth)

  /// The space in front of the back: between the sides, from the base up to
  /// the top, and from the front of the base back to the panel. A divider,
  /// shelves, drawers and doors.
  region in_front = opening(
    left:   panel.left,
    right:  panel.right,
    bottom: stands_on.top,
    top:    under.bottom,
    front:  stands_on.front,
    back:   panel.front,
  )
}
