stave 1

/// A full-extension ball-bearing slide that mounts on the side of a drawer
/// box. Needs 12.7mm (1/2in) between the drawer side and the cabinet.
kind side_mount_slide : slide {
  roles {
    piece: Part                      // the drawer side
    in:    Region                    // the opening it runs in
  }
  /// Closed length of the slide; they are sold in these sizes.
  param length = 500mm within [250mm, 300mm, 350mm, 400mm, 450mm, 500mm, 550mm, 600mm]
  clearance: 12.7mm
  travel:    length                      // full extension: the drawer comes all the way out

  // The cabinet member and the bearings fill exactly the clearance between
  // the drawer side and the side of its opening.
  require gap : between(mount, in) == 12.7mm "the slide needs exactly this much beside the drawer"
  // The drawer member is screwed along the drawer side: a slide longer
  // than the side, or taller than it, hangs off it with its screws in air.
  require on_drawer_side : contact(drawer_member, piece).length >= length && contact(drawer_member, piece).width >= 45mm "the slide hangs off the drawer side; choose a shorter slide or a longer, taller drawer side"

  // On the side of the drawer box nearer the cabinet, its front end level
  // with the side's, centred up and down.
  mount {
    face:   face(piece, nearer: in)
    across: center(piece)
    along:  from(end(piece, toward: front))
  }

  /// The cabinet member: screwed to the inside of the cabinet side; it
  /// stays put.
  member cabinet_member {
    with:  in
    shape: box(along: 0mm..length, across: 45mm, depth: -12.7mm..-6.35mm)
  }
  /// The drawer member: screwed to the side of the drawer box; it runs out
  /// on ball bearings inside the cabinet member.
  member drawer_member {
    with:  piece
    shape: box(along: 0mm..length, across: 45mm, depth: -6.35mm..0mm)
  }

  // The drawer member runs in the cabinet member, out toward the front:
  // along runs back from the front end, so pulling out is against it.
  mechanism {
    rail drawer_member, cabinet_member along along
    drive: travel(drawer_member, from: 0mm, to: -length)
  }
}
