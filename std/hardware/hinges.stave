stave 1

/// A concealed 35mm cup hinge for an overlay door (the common European
/// clip-on kind). The cup is bored into the back of the door's hinge stile;
/// the mounting plate screws to the inside face of the cabinet side, on the
/// 37mm screw line of 32mm-system cabinets. The hinge is a four-bar
/// linkage: an arm on the plate, two links, and the boss in the cup, so the
/// door moves forward and out as it turns and clears the side it covers.
/// Numbers are catalogue values for a full-overlay 110° hinge on a 0mm
/// plate (Hettich Sensys 8645i).
kind euro_hinge : hinge {
  roles {
    piece: Part                      // the door's hinge stile
    on:    Part                      // the cabinet side
  }
  /// How far the door opens; a clip-on limiter stops it sooner.
  param opening_angle = 110deg within 85deg..110deg
  /// From the door's edge to the rim of the cup (the boring distance).
  param cup_inset = 5mm within [3mm, 4mm, 4.5mm, 5mm, 6mm, 7mm]
  /// From the cabinet's front edge back to the plate's screw line.
  param plate_setback = 37mm within [37mm, 52mm]
  /// How far the mounting plate lifts the arm off the side (the catalogue's
  /// distance): a taller plate gives a smaller overlay.
  param plate_height = 0mm within [0mm, 1.5mm, 3mm, 6mm, 9mm]
  cup_diameter: 35mm
  cup_depth:    12.8mm

  // On the back of the stile, the cup's centre cup_inset and half the cup
  // in from the edge nearer the side. The design says where along it.
  mount {
    face:   back
    across: from(edge(piece, nearer: on), inset: cup_inset + 35mm / 2)
    along:  open
  }

  /// The mounting plate: screwed to the inside of the cabinet side, it
  /// holds the hinge on the side and never moves.
  member plate {
    with:  on
    // Drawn at its catalogue place: 11mm thick plus plate_height, standing
    // off the side's inside face, which lies 5mm + plate_height outside the
    // cup's centre (so the door overlays the side by 12.5mm + cup_inset -
    // plate_height); 36mm wide, its middle plate_setback back from the
    // side's front face (the screw line), which lies against the back of
    // the door; 50mm long, centred on the cup.
    shape: box(
      along:  50mm,
      across: -(5mm + plate_height)..6mm,
      depth:  -(plate_setback + 18mm)..-(plate_setback - 18mm),
    )
    mount {
      across: from(face(on, toward: piece), inset: -(5mm + plate_height))
      depth:  from(face(on, toward: piece))
    }
  }
  /// The arm: it clips onto the plate and reaches out to the door; its
  /// screws set how far the door overlays the side.
  member arm {
    with:          on
    // From the back of the plate to the back of the door, and the knuckle
    // that reaches into the cup and carries the arm's two pins. The plate
    // is 36mm wide, centred plate_setback back from the side's front edge.
    shape body:    box(along: 16mm, across: -2.90mm..15.00mm, depth: -(plate_setback + 18mm)..0mm)
    shape knuckle: box(along: 16mm, across: 8.00mm..15.00mm, depth: 0mm..12.40mm)
  }
  /// The cup: a steel cup pressed into a 35mm hole bored in the back of
  /// the door. The boss in its middle is where the links are pinned.
  member cup {
    with:  piece
    // cup_diameter by cup_depth: a shape may use the kind's params, not
    // its fields.
    shape: cylinder(diameter: 35mm, depth: 0mm..12.8mm)
  }
  /// The inner link: a solid steel bar, deeper in the cup when the door is
  /// closed. It and the outer link are pinned to the arm at one end and to
  /// the cup at the other; as the door opens they fold out, pushing the
  /// door forward and away from the side so its edge doesn't hit it.
  member inner_link {
    shape: bar(
      from:      point(across: 13.50mm, depth: 10.90mm),
      to:        point(across: -8.80mm, depth: 7.33mm),
      thickness: 1.50mm,
      along:     9mm,
    )
  }
  /// The outer link: a strap whose two sides pass either side of the inner
  /// link.
  member outer_link {
    shape near: bar(
      from:      point(across: 13.28mm, depth: 3.56mm),
      to:        point(across: -9.54mm, depth: 1.39mm),
      thickness: 1.50mm,
      along:     5.50mm..7mm,
    )
    shape far:  bar(
      from:      point(across: 13.28mm, depth: 3.56mm),
      to:        point(across: -9.54mm, depth: 1.39mm),
      thickness: 1.50mm,
      along:     -7mm..-5.50mm,
    )
  }

  // A four-bar linkage: the cup hangs on the two links from the arm. The
  // pins are the catalogue hinge's, fitted in
  // docs/hardware/cup-hinge-linkage.md.
  mechanism {
    pivot arm, inner_link at point(across: 13.50mm, depth: 10.90mm)
    pivot cup, inner_link at point(across: -8.80mm, depth: 7.33mm)
    pivot arm, outer_link at point(across: 13.28mm, depth: 3.56mm)
    pivot cup, outer_link at point(across: -9.54mm, depth: 1.39mm)
    pin_diameter: 3mm
    drive:        turn(cup, from: 0deg, to: opening_angle)
    stop:         opening_angle "the limiter in the arm stops the door here"
  }

  // The 35mm hole the cup is pressed into, cup_depth deep.
  cut cup_bore: crossing(piece, cup) { drill(diameter: 35mm, depth: 12.8mm) }

  // The arm's side screw sets it 2mm either way on the plate, moving the
  // door in or out over the side.
  adjust arm on plate: across within 2mm
}

/// A wide-angle concealed cup hinge: the door opens to 165°, clear of
/// pull-out shelves and drawers behind it. Mounted like euro_hinge: the
/// cup bored into the back of the door's hinge stile, the plate on the
/// inside of the cabinet side. Its links are cranked: each bends down into
/// the deep cup, so that as the door swings wide they pass through the bore
/// and not through the wood between the bore and the door's edge.
/// PLACEHOLDER PINS: the pins, elbows and arm are fitted to Stave's own
/// checks (a 17.5mm overlay on an 18mm door), not to a maker's catalogue;
/// fit them to one with the refit test (crates/stave-app/tests/
/// oracle_hinge.rs, refit_the_cup_hinge) and name it here before this kind
/// is sold as a product.
kind wide_hinge_165 : hinge {
  roles {
    piece: Part                      // the door's hinge stile
    on:    Part                      // the cabinet side
  }
  /// How far the door opens; the arm's limiter stops it here.
  param opening_angle = 165deg within 90deg..165deg
  /// From the door's edge to the rim of the cup (the boring distance).
  param cup_inset = 5mm within [5mm]
  /// From the cabinet's front edge back to the plate's screw line.
  param plate_setback = 37mm within [37mm]
  cup_diameter: 35mm
  cup_depth:    12.8mm

  // On the back of the stile, the cup's centre cup_inset and half the cup
  // in from the edge nearer the side. The design says where along it.
  mount {
    face:   back
    across: from(edge(piece, nearer: on), inset: cup_inset + 35mm / 2)
    along:  open
  }

  /// The cup: a steel cup pressed into a 35mm hole bored in the back of
  /// the door. The boss in its middle is where the links are pinned.
  member cup {
    with:  piece
    shape: cylinder(diameter: 35mm, depth: 0mm..12.8mm)
  }
  /// The mounting plate: screwed to the inside of the cabinet side.
  member plate {
    with:  on
    // Drawn at its place for a 17.5mm overlay: the side's inside face 5mm
    // outside the cup's centre, the side's front face against the door.
    shape: box(along: 50mm, across: -5mm..6mm, depth: -(plate_setback + 18mm)..-(plate_setback - 18mm))
    mount {
      across: from(face(on, toward: piece), inset: -5mm)
      depth:  from(face(on, toward: piece))
    }
  }
  /// The arm: it clips onto the plate and reaches out to the door, its
  /// knuckle carrying the arm's two pins inside the cup.
  member arm {
    with:          on
    shape body:    box(along: 16mm, across: -2.90mm..14.30mm, depth: -(plate_setback + 18mm)..0mm)
    shape knuckle: box(along: 16mm, across: 11.10mm..14.30mm, depth: 0mm..9.95mm)
  }
  /// The inner link: a solid steel bar, bent down into the cup.
  member inner_link {
    shape arm_end: bar(
      from:      point(across: 12.62mm, depth: 6.87mm),
      to:        point(across: -2.61mm, depth: 11.01mm),
      thickness: 1.50mm,
      along:     9mm,
    )
    shape cup_end: bar(
      from:      point(across: -2.61mm, depth: 11.01mm),
      to:        point(across: -11.63mm, depth: 1.10mm),
      thickness: 1.50mm,
      along:     9mm,
    )
  }
  /// The outer link: a strap whose two sides pass either side of the inner
  /// link, bent down into the cup like it.
  member outer_link {
    shape near_arm_end: bar(
      from:      point(across: 12.78mm, depth: 8.45mm),
      to:        point(across: -7.62mm, depth: 10.20mm),
      thickness: 1.50mm,
      along:     5.50mm..7mm,
    )
    shape near_cup_end: bar(
      from:      point(across: -7.62mm, depth: 10.20mm),
      to:        point(across: -11.09mm, depth: 2.13mm),
      thickness: 1.50mm,
      along:     5.50mm..7mm,
    )
    shape far_arm_end:  bar(
      from:      point(across: 12.78mm, depth: 8.45mm),
      to:        point(across: -7.62mm, depth: 10.20mm),
      thickness: 1.50mm,
      along:     -7mm..-5.50mm,
    )
    shape far_cup_end:  bar(
      from:      point(across: -7.62mm, depth: 10.20mm),
      to:        point(across: -11.09mm, depth: 2.13mm),
      thickness: 1.50mm,
      along:     -7mm..-5.50mm,
    )
  }

  // A four-bar linkage, as euro_hinge's: the cup hangs on the two links
  // from the arm.
  mechanism {
    pivot arm, inner_link at point(across: 12.62mm, depth: 6.87mm)
    pivot cup, inner_link at point(across: -11.63mm, depth: 1.10mm)
    pivot arm, outer_link at point(across: 12.78mm, depth: 8.45mm)
    pivot cup, outer_link at point(across: -11.09mm, depth: 2.13mm)
    drive: turn(cup, from: 0deg, to: opening_angle)
    stop:  opening_angle "the arm's limiter stops the door here"
  }

  // The 35mm hole the cup is pressed into, cup_depth deep.
  cut cup_bore: crossing(piece, cup) { drill(diameter: 35mm, depth: 12.8mm) }

  // The arm's side screw sets it 2mm either way on the plate.
  adjust arm on plate: across within 2mm
}

/// A brass butt hinge: two leaves on a pin, for box lids and small doors.
/// Each leaf is housed in a shallow mortise, one in the lid or door and one
/// in the box or cabinet, so the parts close face to face and only the
/// knuckle shows. Sizes are typical for solid brass box hinges.
kind butt_hinge : hinge {
  roles {
    piece: Part                      // the lid or door
    on:    Part                      // the box or cabinet
  }
  /// Length of the hinge along its pin.
  param length = 40mm within [25mm, 30mm, 40mm, 50mm, 65mm, 75mm]
  /// Width of one leaf, from the pin to its edge; no more than the
  /// thickness of the board it is housed in.
  param leaf_width = length * 3 / 10
  /// How far it opens.
  param opening_angle = 180deg within 90deg..180deg
  /// The knuckle: the barrel the pin runs through, outside the edge.
  param knuckle_diameter = 5mm within [4mm, 5mm, 6mm]

  // On the face of the lid or door that closes against the box, the pin
  // on the edge where the two parts are flush. The design says where
  // along it.
  mount {
    face:   back
    across: from(edge(piece, flush_with: on))
    along:  open
  }

  /// The leaf in the lid or door, flush in its own shallow mortise; it
  /// turns on the pin through the knuckle.
  member leaf {
    with:  piece
    shape: box(along: length, across: 0mm..leaf_width, depth: 0mm..1.5mm)
  }
  /// The leaf in the box or cabinet, flush in its own shallow mortise:
  /// just off the mount face, so the mount face must lie against it.
  member fixed_leaf {
    with:  on
    shape: box(along: length, across: 0mm..leaf_width, depth: -1.5mm..0mm)
  }

  // The leaf in the lid or door turns on the pin in the middle of the
  // knuckle: in the face the two parts close on, the knuckle's radius
  // outside the edge where they are flush.
  mechanism {
    pivot leaf, fixed_leaf at point(across: -knuckle_diameter / 2, depth: 0mm)
    drive: turn(leaf, from: 0deg, to: opening_angle)
  }

  // A shallow mortise for each leaf, as deep as the leaf is thick.
  cut leaf_mortise: crossing(piece, leaf) { notch(depth: 1.5mm) }
  cut fixed_leaf_mortise: crossing(on, fixed_leaf) { notch(depth: 1.5mm) }
}
