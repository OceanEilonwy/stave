stave 1

/// A concealed 35mm cup hinge for an overlay door (the common European
/// clip-on kind). The cup is bored into the back of the door's hinge stile;
/// the mounting plate screws to the inside face of the cabinet side, on the
/// 37mm screw line of 32mm-system cabinets. Numbers are typical catalog
/// values for a full-overlay 110° hinge on a cruciform plate.
kind euro_hinge : hinge {
  /// How far the door opens.
  param opening_angle = 110deg within [95deg, 110deg, 125deg, 155deg, 165deg]
  /// From the door's edge to the rim of the cup (the boring distance).
  param cup_inset = 5mm within [3mm, 4mm, 5mm, 6mm, 7mm]
  /// From the cabinet's front edge back to the plate's screw line.
  param plate_setback = 37mm within [37mm, 52mm]
  cup_diameter: 35mm
  cup_depth:    13mm
  plate:        box(length: 50mm, width: 36mm, thickness: 11mm)
}

/// A brass butt hinge: two leaves on a pin, for box lids and small doors.
/// Each leaf is housed in a shallow mortise, one in the lid or door and one
/// in the box or cabinet, so the parts close face to face and only the
/// knuckle shows. Sizes are typical for solid brass box hinges.
kind butt_hinge : hinge {
  /// Length of the hinge along its pin.
  param length = 40mm within [25mm, 30mm, 40mm, 50mm, 65mm, 75mm]
  /// Width of one leaf, from the pin to its edge; no more than the
  /// thickness of the board it is housed in.
  param leaf_width = length * 3 / 10
  /// How far it opens.
  param opening_angle = 180deg within 90deg..180deg
  leaf: box(length: length, width: leaf_width, thickness: 1.5mm)
}
