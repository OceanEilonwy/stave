stave 1

/// Screws through one part into another. The piece gets clearance holes, the
/// other part gets pilot holes.
kind screw : joint {
  /// Shank diameter of the screws.
  param diameter = 4mm
  /// Length of the screws.
  param length = 30mm
  /// Screws per connection.
  param count = 2
  /// How much of the other part lies in the screw's path: its thickness
  /// for a screw into a face, its width for a screw into an edge.
  param bite = extent(into, thickness, of: piece)
  require stays_inside : length <= piece.thickness + bite - 3mm "the screw would come out the other side"
  require bites        : length >= piece.thickness + 8mm "the screw is too short to hold"

  insert: [push(piece, along: thickness)]
  uses:   wood_screw(diameter: diameter, length: length, count: count)

  cut crossing(piece, into) {
    drill(diameter: diameter + 0.5mm, depth: through, count: count)
  }
  cut crossing(into, piece) {
    drill(diameter: diameter * 3 / 4, depth: length - piece.thickness, count: count)
  }

  note: "Clamp the parts together and drill the pilot holes through the clearance holes"
}
