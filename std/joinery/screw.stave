stave 1

/// Screws through one part into another. The piece gets clearance holes, the
/// other part gets pilot holes.
kind screw : joint {
  /// Shank diameter of the screws.
  param diameter = 4mm
  /// Length of the screws.
  param length = 30mm
  /// Screws per connection.
  param count = 2
  /// How much of the other part lies in the screw's path: its thickness
  /// for a screw into a face, its width for a screw into an edge.
  param bite = extent(into, thickness, of: piece)
  /// Wood left each side of a screw, across the patch where the parts
  /// touch. 6mm is about one and a half times a common 4mm screw: less and
  /// the screw splits the edge it is driven into.
  param wall = 6mm
  /// Wood left between neighbouring screws, and from the end screws to the
  /// ends of the patch: about four times a common 4mm screw. Screws driven
  /// closer than this split the wood along the grain between them.
  param gap = 15mm

  // The holes are centred across the patch where the parts touch and
  // spread evenly along it.
  require stays_inside : length <= piece.thickness + bite - 3mm "the screw would come out the other side"
  require bites        : length >= piece.thickness + 8mm "the screw is too short to hold"
  require seat_wide    : contact(piece, into).width >= diameter + 2 * wall "the parts overlap too little for screws this thick"
  require seat_long    : contact(piece, into).length >= count * (diameter + gap) + gap "too many screws for this joint"

  insert: [push(piece, along: thickness)]
  uses:   wood_screw(diameter: diameter, length: length, count: count)

  cut clearance_hole: crossing(piece, into) {
    drill(diameter: diameter + 0.5mm, depth: through, count: count)
  }
  cut pilot_hole: crossing(into, piece) {
    drill(diameter: diameter * 3 / 4, depth: length - piece.thickness, count: count)
  }

  note: "Clamp the parts together and drill the pilot holes through the clearance holes"
}
