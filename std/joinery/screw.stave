stave 1

/// Screws through one part into another. The piece gets clearance holes, the
/// other part gets pilot holes.
kind screw : joint {
  /// Shank diameter of the screws.
  param diameter = 4mm
  /// Length of the screws.
  param length = 30mm
  /// Screws per connection.
  param count = 2
  /// Wood left each side of a screw, across the patch where the parts
  /// touch. 6mm is about one and a half times a common 4mm screw: less and
  /// the screw splits the edge it is driven into.
  param wall = 6mm
  /// Wood left between neighbouring screws, and from the end screws to the
  /// ends of the patch: about four times a common 4mm screw. Screws driven
  /// closer than this split the wood along the grain between them.
  param gap = 15mm
  /// The pilot hole: about three quarters of the shank, the size of the
  /// screw's core, so the thread cuts its own way into the wood around it.
  param pilot = diameter * 3 / 4

  // The screws are centred across the patch where the parts touch and
  // spread evenly along it. pilot_wall: the pilot hole keeps 3mm of wood
  // to every face of the other part (its far side too) and to its other
  // cuts, so the screw doesn't come out or run into another hole.
  require pilot_wall : wall(pilot_hole) >= 3mm "the screw comes too close to a face of the part or another cut"
  require bites      : length >= piece.thickness + 8mm "the screw is too short to hold"
  require seat_wide  : contact(piece, into).width >= diameter + 2 * wall "the parts overlap too little for screws this thick"
  require seat_long  : contact(piece, into).length >= count * (diameter + gap) + gap "too many screws for this joint"

  insert: [push(piece, along: thickness)]

  /// The screws: driven through the piece and into the other part. Each is
  /// drawn and checked at the size of its core, the pilot hole: the thread
  /// bites into the wood around it and takes no room of its own.
  member screw : wood_screw(diameter: diameter, length: length) {
    on:     contact(piece, into)
    count:  count
    spaced: evenly
    shape:  cylinder(diameter: pilot, depth: -piece.thickness..length - piece.thickness)
  }
  cut clearance_hole: crossing(piece, screw) { drill(diameter: diameter + 0.5mm, depth: through) }
  cut pilot_hole: crossing(into, screw) { drill(diameter: pilot, depth: length - piece.thickness) }

  note: "Clamp the parts together and drill the pilot holes through the clearance holes"
}
