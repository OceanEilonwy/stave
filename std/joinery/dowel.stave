stave 1

/// A dowel joint: matching holes in both parts, with glued wooden pins. The
/// end or edge of the piece butts against a face of the other part.
kind dowel : joint {
  /// Diameter of the pins and their holes.
  param diameter = 8mm
  /// Pins per connection.
  param count = 2
  /// Depth of the hole in each part; a pin is twice this long.
  param depth = 15mm
  /// Wood left beside each hole: to the edges of the patch where the
  /// parts touch, between neighbouring holes, and round the hole in the
  /// other part (to its faces and its other cuts). Less and the wood
  /// beside a hole splits when the glued pin swells.
  param wall = 4mm

  // The pins are centred across the patch where the parts touch and
  // spread evenly along it. Each hole keeps `wall` of wood to every face
  // of its part (its far side too) and to every other cut there, its other
  // copies included: its `wall:`. Every side of the patch is a face of one
  // of the parts, so that also keeps the patch a hole and a wall each side
  // wide, and long enough for every hole with a wall between and beyond.
  require pin_fits_piece : diameter <= piece.thickness / 2 "the dowel is too thick for this board"

  insert: [push(piece, along: length)]

  /// The pins: wooden dowels glued half into each part, in matching holes.
  member pin : dowel_pin(diameter: diameter, length: 2 * depth) {
    on:     contact(piece, into)
    count:  count
    spaced: evenly
    shape:  cylinder(diameter: diameter, depth: -depth..depth)
  }
  cut end_hole: crossing(piece, pin) { drill(diameter: diameter, depth: depth, wall: wall) }
  cut hole: crossing(into, pin) { drill(diameter: diameter, depth: depth, wall: wall) }

  note: "Drill both sets of holes from the same reference edge so they line up"
}
