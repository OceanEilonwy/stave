stave 1

/// A dowel joint: matching holes in both parts, with glued wooden pins. The
/// end or edge of the piece butts against a face of the other part.
kind dowel : joint {
  /// Diameter of the pins and their holes.
  param diameter = 8mm
  /// Pins per connection.
  param count = 2
  /// Depth of the hole in each part; a pin is twice this long.
  param depth = 15mm
  /// Wood left beside each hole: to the edges of the patch where the
  /// parts touch, and between neighbouring holes. Less and the wood beside
  /// a hole splits when the glued pin swells.
  param wall = 4mm

  // The holes are centred across the patch where the parts touch and
  // spread evenly along it, so the patch must be a hole and a wall each
  // side wide, and long enough for every hole with a wall between and
  // beyond them.
  require pin_fits_piece : diameter <= piece.thickness / 2 "the dowel is too thick for this board"
  require hole_stops     : depth <= extent(into, length, of: piece) - 3mm "the dowel hole would come through the other side"
  require seat_wide      : contact(piece, into).width >= diameter + 2 * wall "the parts overlap too little for these dowels"
  require seat_long      : contact(piece, into).length >= count * (diameter + wall) + wall "too many dowels for this joint"

  insert: [push(piece, along: length)]
  uses:   dowel_pin(diameter: diameter, length: 2 * depth, count: count)

  cut end(piece, facing: into) {
    drill(diameter: diameter, depth: depth, count: count)
  }
  cut crossing(into, piece) {
    drill(diameter: diameter, depth: depth, count: count)
  }

  note: "Drill both sets of holes from the same reference edge so they line up"
}
