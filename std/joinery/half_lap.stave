stave 1

/// A half lap: two parts that cross, each notched to half its thickness so
/// their faces end up flush.
kind half_lap : joint {
  roles {
    piece: Part
    into:  Part
  }
  require same_thickness : piece.thickness == into.thickness "both parts need the same thickness for flush faces"
  // Lifted part way out of each other, the laps would stand apart. Parts
  // that don't overlap at all are left to the check that joints meet.
  require crosses_fully : extent([piece, into], thickness, of: into) == into.thickness || extent([piece, into], thickness, of: into) >= piece.thickness + into.thickness "the parts must cross by their whole thickness for the laps to meet"

  insert: [push(piece, along: thickness)]

  cut lap: crossing(into, piece) {
    notch(depth: into.thickness / 2)
  }
  cut mating_lap: crossing(piece, into, opposite: true) {
    notch(depth: piece.thickness / 2)
  }

  note: "Mark both notches from the parts themselves, not from a ruler"
}
