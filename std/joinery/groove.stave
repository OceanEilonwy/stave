stave 1

/// A groove: a housing along the grain that holds the edge of a panel, such as
/// a door panel in its frame or a drawer bottom in the drawer box. A plywood
/// panel may be glued in; a solid panel must float, so write glue: false
/// and give it a clearance to swell into (Stave warns about a solid panel
/// glued across its grain).
kind groove : joint {
  /// How deep the groove is cut.
  param depth = 8mm
  /// Room left at the bottom of the groove so a solid panel can swell.
  param clearance = 0mm

  // not_too_deep is dado's rule, measured square to where the panel meets
  // the board: the board's thickness for a groove in its face (a box's
  // bottom), its width for a groove in its edge (a door frame's stiles).
  require panel_is_held : clearance < depth "the panel must reach into the groove"
  require not_too_deep  : depth <= extent(into, thickness, of: contact(piece, into)) / 2 "a groove deeper than half the board weakens it"

  insert:    [push(piece, along: length)]
  cut_first: into                                  // cut the groove first, then size the panel to it
  adds:      extend(piece, by: depth - clearance)  // the panel reaches into every groove it meets

  cut groove: crossing(into, piece) {
    notch(depth: depth)
  }

  note: "Slide {piece} into its grooves while the frame goes together; a solid panel is not glued"
}
