stave 1

/// A rabbet: a step cut along the edge of a board, for example to house a
/// cabinet back so its edges don't show from the side.
kind rabbet : joint {
  /// How far the step reaches into the board.
  param depth = into.thickness / 2
  require not_too_deep : depth <= into.thickness * 2 / 3 "a rabbet this deep leaves too little of the board"

  insert:    [push(piece, along: thickness)] // drops in from behind
  cut_first: into                            // cut the rabbet first, then fit the panel to it
  adds:      extend(piece, by: depth)        // the panel is cut wider by the depth at each housed edge

  cut rabbet: crossing(into, piece) {
    notch(depth: depth)
  }

  note: "Fit {piece} into the rabbets before fastening it"
}
