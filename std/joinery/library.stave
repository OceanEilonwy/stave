stave 1

// std:joinery — the standard joints and the recipes that cut them. They are
// written in the same format as any third-party joint library, and are in the
// prelude: projects use them without an import or a prefix (dado(...), not
// joinery.dado(...)).
//
// Joints:  dado, rabbet, groove, dowel, round_tenon, socket, screw,
//          cope_and_stick, mortise_tenon, half_lap
// Edge joints, for wide parts made of boards (see "Boards" in the grammar):
//          glued_edge (the default), tongue_and_groove, splined_edge,
//          chigiri (butterfly keys), suitsuki_zan (sliding dovetail battens)
// Recipes: one or more for every cut operation and for turning, in
//          recipes.stave. Power-tool recipes rank before hand-tool recipes,
//          so a project gets the power method only if it lists those tools.

library "Joinery" {
  about:   "The standard joints and the recipes that cut them"
  license: "AGPL-3.0-or-later"
  // How a part made of boards is joined when neither it nor its project
  // says (grammar, "Boards").
  boards:  joined(by: glued_edge)
}
