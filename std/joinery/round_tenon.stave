stave 1

/// A round tenon: a pin turned or cut on the end of a part, glued into a
/// matching hole. Used for turned feet, legs and rails.
kind round_tenon : joint {
  /// Diameter of the tenon and of its hole.
  param diameter = 19mm
  /// How far the tenon reaches into the other part.
  param length = into.thickness * 2 / 3
  /// The ring of end grain left round the tenon, which the part seats
  /// on: less and the shoulder crushes or splits when it is glued home.
  param shoulder = 3mm
  /// Wood left round the hole: to every face of the other part (its far
  /// side too) and to its other cuts.
  param wall = 3mm

  // tenon_fits: the patch where the parts touch is as wide as the end of
  // the piece; for a turned piece, its profile's diameter at that end.
  require hole_wall  : wall(hole) >= wall "the hole for the tenon comes too close to a face of the board or another cut"
  require tenon_fits : diameter <= contact(piece, into).width - 2 * shoulder "the tenon is too thick for the end of the part"

  insert:    [push(piece, along: length)]
  cut_first: into                            // drill the hole first, then fit the tenon to it
  adds:      extend(piece, by: length)       // the tenon is extra length on the piece

  cut round_tenon: end(piece, facing: into) {
    spigot(diameter: diameter, length: length)
  }
  cut hole: crossing(into, piece) {
    drill(diameter: diameter, depth: length)
  }

  note: "The tenon should push in by hand; cut a glue groove along it so trapped glue can escape"
}
