stave 1

/// A socket: a round hole that takes the whole end of a round part, such as a
/// clothes rod between two cabinet sides.
kind socket : joint {
  /// How deep the hole is.
  param depth = into.thickness / 2
  require not_too_deep : depth <= extent(into, length, of: piece) / 2 "a socket deeper than half the board weakens it"

  insert:    [push(piece, along: length)]
  cut_first: into
  adds:      extend(piece, by: depth)        // the rod is cut longer by the depth at each end

  cut socket: crossing(into, piece) {
    drill(diameter: piece.diameter, depth: depth, wall: wall)
  }

  /// Wood left round the hole: to every face of the board and to its other
  /// cuts, such as a dado or another socket. Less and the wood between two
  /// sockets in a leg, or between a socket and the edge of a board, splits
  /// when the rod or rung is driven home.
  param wall = 6mm

  note: "A rod between two sockets goes in while the case is glued up, not afterwards"
}
