# The door fixture: a door chosen for the bay, hinged on the left side,
# overlaying it almost to the wall, so it swings into the wall: refused,
# with the checker's fix offered.
select region bay
choose Door
# The hinge side pointed at on the model: the inside face of side_l,
# clicked through the bay.
point face side_l.right
set mount = overlay(left: 17.8mm, right: 17.8mm)
# The fix applied: it fits, its ghost green.
fix 1 1
