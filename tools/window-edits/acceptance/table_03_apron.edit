# A click in the gap between the two front legs: Apron; the top, then
# the front leg's front face and its right face pointed at on the model.
select between legs.leg[front_left] legs.leg[front_right]
choose frames.Apron
point face top.board.top
point face legs.leg[front_left].front
point face legs.leg[front_left].right
set apron_stock = oak_19
set run = right
