#!/bin/sh
# Regenerates every screenshot of the desktop window in docs/screenshots/
# (window/ and files/) with tools/window-shot, so they can be checked
# against the design after a change to the GUI.
#
#   tools/gui-screenshots            build stave-gtk, then take every shot
#   tools/gui-screenshots NAME...    only the shots whose path contains NAME
#                                    (e.g. 'library' or 'files/')
#
# CARGO_TARGET_DIR is honoured (and passed on to tools/window-shot), so a
# lane can use its own build. Each shot below says what it shows; look at
# every one that changed before committing it.
set -eu

cd "$(dirname "$0")/.."

cargo build --quiet -p stave-gtk -p stave-cli

window=docs/screenshots/window
files=docs/screenshots/files
cabinet=examples/clothing_cabinet
hinge='door_l.hinges[upper]'
failed=0
filters="$*"

shot() {
    out=$1
    shift
    if [ -n "$filters" ]; then
        wanted=no
        for filter in $filters; do
            case $out in *"$filter"*) wanted=yes ;; esac
        done
        [ "$wanted" = yes ] || return 0
    fi
    if ! tools/window-shot "$out" "$@"; then
        echo "error: couldn't take $out" >&2
        failed=1
    fi
}

# ---- the window (docs/screenshots/window) ----

# The design with nothing chosen: the 3D view filling the window, the model
# tree floating at its top left, the dock at the bottom, the rail of open
# files at the right edge (V2C_Home); and a project with problems, each
# pinned where it happens and dotted in the tree.
shot $window/home.png $cabinet --theme light
shot $window/home_problems.png crates/stave-app/tests/projects/several_problems --theme light
# A hinge stile chosen, light and dark: the camera frames it between the
# tree and its card, the rest of the design dims, the tree lists the
# joints it is in, and the card beside it says what it is (V2C_Spatial).
shot $window/main_light.png $cabinet --theme light --select 'door_l.stile[hinge]'
shot $window/main_dark.png $cabinet --theme dark --select 'door_l.stile[hinge]'
# A selection close up: the mirrored door's latch stile with its accent
# outline and flat wash, no grain showing through; and a whole assembly
# selected, outlined as one.
shot $window/selected_close.png $cabinet --theme light --select 'door_r.stile[latch]' --zoom 3.5 --turn 15
shot $window/selected_close_dark.png $cabinet --theme dark --select 'door_r.stile[latch]' --zoom 3.5 --turn 15
shot $window/selected_assembly.png $cabinet --theme light --select door_l
# A narrow window: the finder's field and the switcher's words go; the
# tree and the card still float over the view.
shot $window/narrow.png $cabinet --theme light --select 'door_l.stile[hinge]' --size 760x900
shot $window/narrow_dark.png $cabinet --theme dark --select 'door_l.stile[hinge]' --size 760x900
# The problems chip while a check runs (the spinner keeps the last
# result's tone).
shot $window/checking.png tests/broken/door_hits_side --theme light --checking
# The build button pressed: its check running.
shot $window/building.png examples/stool --theme light --select 'leg[front_left]' --building
# Pulled apart, light and dark: drawers and doors out first, then every
# part out of its joints; the dock grows its play button and slider.
shot $window/exploded.png $cabinet --theme light --explode 1
shot $window/exploded_dark.png $cabinet --theme dark --explode 1
# The stool pulled apart: the legs drop off the seat and out at their
# corners, and the rungs drop with them, out of their sockets.
shot $window/exploded_stool.png examples/stool --theme light --explode 1
# Focus mode on a joint: the stool's rung socket, part way through its
# insert step (JointFocus).
shot $window/focus.png examples/stool --theme light --focus rung_sockets --step 0.6
# Focus mode on dowel joints: the pins ride on the piece and go into their
# holes in the part drawn see-through, framed on the pins; the cabinet's
# side into its top, and the bookshelf's kick into a side.
shot $window/focus_dowels.png $cabinet --theme light --focus top_dowels --step 0.4
shot $window/focus_kick_dowels.png examples/bookshelf --theme light --focus kick_dowels --step 0.5
# A joint's pins selected in the normal view: the parts they sit in are
# drawn see-through so they show, and the inspector says which joint
# placed them and where it is written.
shot $window/selected_pins.png $cabinet --theme light --select "top_dowels's pin between side_l and top" --frame-selection --turn 20
# The bookshelf pulled apart: the sides come off the kick's ends, its pins
# staying in the kick.
shot $window/exploded_bookshelf.png examples/bookshelf --theme light --explode 1
# Focus mode on a cup hinge, in 3D and from above, light and dark, and in
# a narrow window (Hinge).
shot $window/hinge_3d.png $cabinet --theme light --focus "$hinge" --step 0.41
shot $window/hinge_plan.png $cabinet --theme light --focus "$hinge" --plan --step 0.41
shot $window/hinge_dark.png $cabinet --theme dark --focus "$hinge" --plan --step 0.41
shot $window/hinge_narrow.png $cabinet --theme light --focus "$hinge" --step 0.41 --size 760x700
# A problem chosen (its pin, or F8): the door posed where it first hits
# the wall, the shared wood in red, what it doesn't involve dimmed, the
# motion card, and the card with the `stave check` text (its code block
# must not look selected) and the ways to fix it (V2C_Problem), light and
# dark.
shot $window/problem.png tests/broken/door_hits_side --theme light --diagnostic 0
shot $window/problem_dark.png tests/broken/door_hits_side --theme dark --diagnostic 0
# A problem about a joint's member: the peg that runs past the bottom of
# its hole, posed with the shared wood in red and the parts it sits in
# see-through.
shot $window/problem_pin.png tests/broken/pin_past_its_hole --theme light --diagnostic 0
# Several problems of several kinds, one chosen: the chip's arrows step
# through them (F8); and the same in a narrow window.
shot $window/problems_several.png crates/stave-app/tests/projects/several_problems --theme light --diagnostic 2
shot $window/problems_narrow.png crates/stave-app/tests/projects/several_problems --theme light --diagnostic 0 --size 760x900
# X-ray from the dock: everything but the chosen part see-through.
shot $window/xray.png $cabinet --theme light --select 'door_l.panel' --xray
# The finder (Ctrl+K) with "hinge" typed: parts, names and lines, grouped,
# with a filter per kind (V2C_Finder), light and dark.
shot $window/finder.png $cabinet --theme light --finder hinge
shot $window/finder_dark.png $cabinet --theme dark --finder door
# A library folder: nothing to draw, so the view says so; the tree lists
# what the library defines and the card says what a library is and how to
# import it, light and dark.
shot $window/library.png examples/japanese_joinery --theme light
shot $window/library_dark.png examples/japanese_joinery --theme dark

# The editing menu and card (docs/editing.md), drawn from the contract's
# hand-built fixture (stave_app::edit) until the edit loop drives them: the
# menu for a click in door_bay[left] (Drawer fits, FramePanelDoor still
# being checked; then greyed with an illustrative reason, dark); the card
# for Drawer refused with the checker's problem and its fix, then fitting
# with Add enabled (dark); with a setting that needs a choice; and
# FramePanelDoor waiting for its hinge side to be pointed at.
shot $window/edit_menu.png $cabinet --theme light --edit-fixture menu
shot $window/edit_menu_greyed_dark.png $cabinet --theme dark --edit-fixture greyed
shot $window/edit_card_refused.png $cabinet --theme light --edit-fixture refused
shot $window/edit_card_fits_dark.png $cabinet --theme dark --edit-fixture fits
shot $window/edit_card_choose.png $cabinet --theme light --edit-fixture choose
shot $window/edit_card_point.png $cabinet --theme light --edit-fixture point

# Editing on the real session (docs/editing.md, docs/gui.md "Editing in the
# 3D view"), each state reached by an edit script (tools/window-edits/) that
# does what the pointer and the card would. The projects are copies in a
# temporary folder, since Add writes: a small chest made by `stave edit
# --script` (a new project with a case in its envelope), and the door
# fixture (crates/stave-gtk/fixtures/door_hits_wall).
edits=tools/window-edits
# A fixed folder, so the window's subtitle is the same on every run.
scratch=${TMPDIR:-/tmp}/stave-window-edits
rm -rf "$scratch"
mkdir -p "$scratch"
trap 'rm -rf "$scratch"' EXIT
stave=${CARGO_TARGET_DIR:-target}/debug/stave
"$stave" edit "$scratch/chest" --script $edits/small_chest.script >/dev/null
door() {
    rm -rf "$scratch/door"
    cp -r crates/stave-gtk/fixtures/door_hits_wall "$scratch/door"
    echo "$scratch/door"
}
# The pointer in the case's space: lit, with the case's front see-through.
shot $window/edit_space_lit.png "$scratch/chest" --theme light --edit-script $edits/space_lit.edit
# A click there: the menu headed "In this space", what needs a choice said.
shot $window/edit_space_menu.png "$scratch/chest" --theme light --edit-script $edits/space_menu.edit
# A click on a part: its card offers to add onto the face clicked.
shot $window/edit_face_button.png "$scratch/chest" --theme light --edit-script $edits/face_button.edit
# The door refused (it swings into the wall) with the fix offered, its ghost
# red and labelled; the fix applied, fitting, its ghost green (light and
# dark); and the design after Add with the door selected, then with the
# editor open, where the change shows unsaved.
shot $window/edit_door_refused.png "$(door)" --theme light --edit-script $edits/door_refused.edit
shot $window/edit_door_fits.png "$(door)" --theme light --edit-script $edits/door_fits.edit
shot $window/edit_door_fits_dark.png "$(door)" --theme dark --edit-script $edits/door_fits.edit
shot $window/edit_door_added.png "$(door)" --theme light --edit-script $edits/door_added.edit
shot $window/edit_door_added_editor.png "$(door)" --theme light --view files --edit-script $edits/door_added.edit
# The New Project dialog (main menu, New Project…).
shot $window/new_project.png "$scratch/chest" --theme light --new-project

# ---- the editor (docs/screenshots/files) ----
# `--view files` opens the editor beside the 3D view, sliding in from the
# right with the file's tab on the rail (V2C_EditorOpen).

# The cursor on a name in the text: the 3D view follows it, framing what
# the name means.
shot $files/linked.png $cabinet --view files --theme light --file doors.stave:9 --cursor door_l
# Peeking at a definition in place (EditorOverlay).
shot $files/peek.png $cabinet --view files --theme light --file doors.stave:9 --cursor FramePanelDoor --peek
# A name's hover card.
shot $files/hover.png $cabinet --view files --theme light --file doors.stave:9 --cursor FramePanelDoor --hover
# The uses of a name in the uses panel, dark.
shot $files/uses_dark.png $cabinet --view files --theme dark --file doors.stave:18 --cursor door_l --uses
# A problem in the text: its underline, gutter mark and hover card.
shot $files/problem.png tests/broken/unknown_name --view files --theme light --file project.stave:10 --cursor pine_18 --hover
# A typo typed into the text, light and dark: the problem shows as you
# type and the 3D link lets go.
shot $files/typed_light.png $cabinet --view files --theme light --file doors.stave:11 --cursor side_l --type q
shot $files/typed_dark.png $cabinet --view files --theme dark --file doors.stave:11 --cursor side_l --type q
# Typing three keys and one Undo: the keys go as one step, the text is as
# saved again and the tab has no unsaved dot.
shot $files/undo.png $cabinet --view files --theme light --file doors.stave:11 --cursor side_l --type qrs --undo
# Ctrl+F in the text: the search bar, "2 of 3", every match highlighted.
shot $files/search.png $cabinet --view files --theme light --file doors.stave:9 --cursor door_l --search side
# The cursor just inside a bracket: it and its partner are boxed, dark.
shot $files/brackets_dark.png $cabinet --view files --theme dark --file doors.stave:18 --cursor door_l
# The editor in a narrow window.
shot $files/narrow.png $cabinet --view files --theme light --size 760x900 --file doors.stave:9 --cursor door_l
# A part chosen with the editor open: the text goes to the line that
# places it and the camera frames it in the room the editor leaves, dark.
shot $files/selected_in_3d_dark.png $cabinet --view files --theme dark --select 'door_l.stile[hinge]'

exit $failed
