#!/bin/sh
# Writes a PNG of the real Stave window, without a screen.
#
#   tools/window-shot OUT.png FOLDER [stave-gtk options...]
#
#   tools/window-shot main.png examples/clothing_cabinet --theme light \
#       --select 'door_l.stile[hinge]'
#   tools/window-shot dark.png examples/clothing_cabinet --theme dark --size 1440x900
#   tools/window-shot busy.png tests/broken/door_hits_side --checking
#   tools/window-shot narrow.png examples/clothing_cabinet --size 760x900
#
# It starts a private GTK Broadway display server (gtk4-broadwayd, which
# needs no screen, no browser and no root), runs `stave-gtk FOLDER
# --window-screenshot OUT.png` on it, and stops the server. The window
# draws itself into the PNG with GTK's own renderer, at exactly the size
# asked for (default 1440x900), with GNOME's default font at 96 dpi and the
# Adwaita icons, so pictures look the same on every machine.
#
# STAVE_GTK names the viewer binary (default: target/debug/stave-gtk under
# CARGO_TARGET_DIR, or ./target).
set -eu

if [ "$#" -lt 2 ]; then
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
fi
out=$1
folder=$2
shift 2

binary=${STAVE_GTK:-${CARGO_TARGET_DIR:-target}/debug/stave-gtk}
if [ ! -x "$binary" ]; then
    echo "error: can't find the viewer at '$binary'; build it with 'cargo build -p stave-gtk' or set STAVE_GTK" >&2
    exit 1
fi
if ! command -v gtk4-broadwayd >/dev/null 2>&1; then
    echo "error: gtk4-broadwayd isn't installed (it comes with GTK 4)" >&2
    exit 1
fi

# A display number nobody uses.
display=$(( ( $$ % 400 ) + 100 ))
runtime=${XDG_RUNTIME_DIR:-/tmp}
while [ -e "$runtime/broadway$(( display + 1 )).socket" ]; do
    display=$(( display + 1 ))
done

log=$(mktemp)
gtk4-broadwayd ":$display" >"$log" 2>&1 &
server=$!
trap 'kill "$server" 2>/dev/null || true; rm -f "$log"' EXIT INT TERM
# Wait for the server's socket.
tries=0
while [ ! -e "$runtime/broadway$(( display + 1 )).socket" ] && [ "$tries" -lt 50 ]; do
    sleep 0.1
    tries=$(( tries + 1 ))
done

GDK_BACKEND=broadway BROADWAY_DISPLAY=":$display" \
    timeout 120 "$binary" "$folder" --window-screenshot "$out" "$@"
